{% comment %}
  商品卡(卡片家族):无框卡片,照片即卡片。图片优先读 metafield yarn.card_image(运营上传的场景图),无则用主图;
  信息行显示品类与真实颜色数;规格行读 metafield yarn.spec_line(可选,无则省略);
  原价只在 compare_at_price 真实存在时划线显示。整卡一个链接目标。
{% endcomment %}
{%- liquid
  assign card_image = card_product.metafields.yarn.card_image.value | default: card_product.featured_image
-%}
<a class="yx-product-card" href="{{ card_product.url }}">
  <div class="yx-product-card__media">
    {%- if card_image != blank -%}
      {{ card_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 750px) 300px, 45vw', loading: 'lazy', alt: card_image.alt | default: card_product.title }}
    {%- endif -%}
  </div>
  <div class="yx-product-card__body">
    {%- render 'yarn-card-meta', meta_product: card_product -%}
    <span class="yx-product-card__title">{{ card_product.title | escape }}</span>
    <span class="yx-product-card__spec">{% render 'yarn-card-spec', product: card_product %}</span>
    <span class="yx-product-card__price">
      {%- if card_product.compare_at_price > card_product.price -%}
        <s class="yx-product-card__was">{{ card_product.compare_at_price | money }}</s>
      {%- endif -%}
      {{ card_product.price | money }}
    </span>
  </div>
</a>
