{%- comment -%}Mobile counterpart to the approved localized flat navigation.{%- endcomment -%}
<header-drawer data-breakpoint="desktop">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>{{- 'icon-hamburger.svg' | inline_asset_content -}}{{- 'icon-close.svg' | inline_asset_content -}}</span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              <li><a id="YarnHeaderDrawer-home" href="{{ home_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'index' %} menu-drawer__menu-item--active{% endif %}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>{{ home_label | escape }}</a></li>
              <li><a id="YarnHeaderDrawer-finished" href="{{ finished_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'search' and search.terms == 'tag:完成品' %} menu-drawer__menu-item--active{% endif %}"{% if request.page_type == 'search' and search.terms == 'tag:完成品' %} aria-current="page"{% endif %}>{{ finished_label | escape }}</a></li>
              <li><a id="YarnHeaderDrawer-materials" href="{{ materials_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'search' and search.terms == 'tag:毛糸' %} menu-drawer__menu-item--active{% endif %}"{% if request.page_type == 'search' and search.terms == 'tag:毛糸' %} aria-current="page"{% endif %}>{{ materials_label | escape }}</a></li>
              <li><a id="YarnHeaderDrawer-contact" href="{{ contact_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'page' and page.handle == 'contact' %} menu-drawer__menu-item--active{% endif %}"{% if request.page_type == 'page' and page.handle == 'contact' %} aria-current="page"{% endif %}>{{ contact_label | escape }}</a></li>
            </ul>
          </nav>
          {%- if show_language_selector and localization.available_languages.size > 1 -%}
            <div class="menu-drawer__localization header-localization">
              <localization-form>
                {%- form 'localization', id: 'HeaderDrawerLanguageForm', class: 'localization-form' -%}
                  <div><h2 class="visually-hidden" id="HeaderDrawerLanguageLabel">{{ 'localization.language_label' | t }}</h2>{%- render 'language-localization', localPosition: 'HeaderDrawerLanguage' -%}</div>
                {%- endform -%}
              </localization-form>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </details>
</header-drawer>
