{%- liquid
  assign chosen_variant = default_variant | default: product.selected_or_first_available_variant
  assign minimum = chosen_variant.quantity_rule.min | default: 1
  assign increment = chosen_variant.quantity_rule.increment | default: 1
  assign quantity = recommended_quantity | default: minimum | at_least: minimum
  assign remainder = quantity | minus: minimum | modulo: increment
  if remainder != 0
    assign quantity = quantity | minus: remainder | plus: increment
  endif
  if chosen_variant.quantity_rule.max != blank
    assign quantity = quantity | at_most: chosen_variant.quantity_rule.max
  endif
  assign form_id = 'ProjectPurchase-' | append: section.id | append: '-' | append: purchase_key
-%}
{%- capture product_url -%}{%- render 'yarn-project-product-url', url: chosen_variant.url, project: project, kind: kind, component_title: component_title -%}{%- endcapture -%}
<yarn-project-purchase class="yp-purchase" data-details-id="{{ details_id | escape }}" data-currency="{{ cart.currency.iso_code | escape }}" data-locale="{{ request.locale.iso_code | escape }}"
  data-available-label="{{ 'yarn_project.add_selected' | t | escape }}" data-sold-out-label="{{ 'yarn_project.unavailable' | t | escape }}">
  <yarn-material-purchase data-pending="{{ 'yarn_project.part_adding' | t | escape }}" data-success="{{ 'yarn_project.selected_added' | t | escape }}"
    data-error="{{ 'yarn_project.part_add_error' | t | escape }}" data-uncertain="{{ 'yarn_project.part_uncertain' | t | escape }}">
    <form method="post" action="{{ routes.cart_add_url }}" id="{{ form_id }}">
      <input type="hidden" name="properties[Project]" value="{{ project.title.value | escape }}">
      <input type="hidden" name="properties[_Project ID]" value="{{ project.system.id | escape }}">
      <input type="hidden" name="properties[_Project handle]" value="{{ project.system.handle | escape }}">
      <input type="hidden" name="properties[_Project mode]" value="{{ kind | escape }}">
      <input type="hidden" name="properties[Component]" value="{{ component_title | default: product.title | escape }}">
      {% if product.variants.size > 8 %}
        <label class="yp-variant-select" for="{{ form_id }}-variant">{{ 'yarn_project.choose_variant' | t }}<select name="id" id="{{ form_id }}-variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == chosen_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — {{ 'yarn_project.unavailable' | t }}{% endunless %}</option>{% endfor %}</select></label>
      {% elsif product.variants.size > 1 %}
        <fieldset class="yp-variant-options">
          <legend class="visually-hidden">{{ 'yarn_project.choose_variant' | t }}</legend>
          <div class="yp-variant-options__row"><span aria-hidden="true">{{ 'yarn_project.choose_variant' | t }}</span><div class="yp-variant-options__list">
            {% for variant in product.variants %}
              <label class="yp-variant-choice">
                <input type="radio" name="id" value="{{ variant.id }}" {% if variant.id == chosen_variant.id %}checked{% endif %} required>
                <span>{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', width: 32, height: 32, alt: '' }}{% endif %}<span>{{ variant.title | escape }}</span></span>
              </label>
            {% endfor %}
          </div></div>
        </fieldset>
      {% else %}<input type="hidden" name="id" value="{{ chosen_variant.id }}">{% endif %}
      <div class="yp-purchase__summary">
        <div class="yp-purchase__quantity">
          <label for="{{ form_id }}-quantity">{{ 'yarn_project.part_quantity' | t }}</label>
          <input id="{{ form_id }}-quantity" type="number" name="quantity" value="{{ quantity }}" min="{{ minimum }}" step="{{ increment }}" {% if chosen_variant.quantity_rule.max != blank %}max="{{ chosen_variant.quantity_rule.max }}"{% endif %} inputmode="numeric" required>
        </div>
        <div class="yp-purchase__total"><span>{{ 'yarn_project.selected_total' | t }}</span><strong data-purchase-total>{{ chosen_variant.price | times: quantity | money_with_currency }}</strong></div>
      </div>
      <button class="yp-action{% if kind == 'finished' %} yp-action--primary{% endif %}" type="submit" {% unless chosen_variant.available %}disabled{% endunless %}>
        {% if chosen_variant.available %}{{ 'yarn_project.add_selected' | t }}{% else %}{{ 'yarn_project.unavailable' | t }}{% endif %}
      </button>
    </form>
    <p class="yp-purchase__status" data-material-status role="status" aria-live="polite" hidden></p>
    <a class="yp-product-action" data-material-cart href="{{ routes.cart_url }}" hidden>{{ 'yarn_project.part_cart' | t }}</a>
  </yarn-material-purchase>
  {% if details_id == blank %}<a class="yp-purchase__details" href="{{ product_url | escape }}" data-purchase-details>{{ 'yarn_project.part_product' | t }} <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>{% endif %}
  <script type="application/json" data-purchase-variants>[
    {% for variant in product.variants %}
      {"id":{{ variant.id | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"min":{{ variant.quantity_rule.min | default: 1 | json }},"step":{{ variant.quantity_rule.increment | default: 1 | json }},"max":{{ variant.quantity_rule.max | json }}}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]</script>
</yarn-project-purchase>
