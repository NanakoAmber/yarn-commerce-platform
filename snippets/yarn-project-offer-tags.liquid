{%- comment -%}
  首页作品卡的购买标签,只按真实关联输出(逗号分隔):
  finished = 有成品(沿用 yarn-project-capabilities 的成品判定);
  kit = 材料或组件里有带「編みものキット」(编织包)标签的商品;
  materials = 除编织包外,还有本店可单独购买的材料或工具。
  不输出「买毛线」:毛线与作品解耦(#50 第 4 条)。Accepts: project
{%- endcomment -%}
{%- capture offer_caps -%}{%- render 'yarn-project-capabilities', project: project -%}{%- endcapture -%}
{%- liquid
  assign offer_kit = false
  assign offer_loose = false
  unless offer_caps contains 'inspiration'
    for component in project.components.value
      assign component_product = component.variant.value.product
      if component_product != blank
        if component_product.tags contains '編みものキット'
          assign offer_kit = true
        elsif component.supply.value == '本店提供'
          assign offer_loose = true
        endif
      endif
    endfor
    for material_product in project.materials.value
      if material_product.tags contains '編みものキット'
        assign offer_kit = true
      else
        assign offer_loose = true
      endif
    endfor
    if project.tools.value != blank
      assign offer_loose = true
    endif
  endunless
  assign offer_tags = ''
  if offer_caps contains 'finished'
    assign offer_tags = 'finished,'
  endif
  if offer_kit
    assign offer_tags = offer_tags | append: 'kit,'
  endif
  if offer_loose and offer_caps contains 'materials'
    assign offer_tags = offer_tags | append: 'materials,'
  endif
  echo offer_tags
-%}
