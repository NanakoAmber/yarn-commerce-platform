{%- liquid
  assign declared_kind = product.metafields.yarn.discovery_kind.value
  assign kind_text = product.type | append: ' ' | append: product.tags | downcase
  assign title_text = product.title | downcase
  if declared_kind == 'finished' or declared_kind == 'materials'
    echo declared_kind
  elsif kind_text contains '完成品' or kind_text contains '成品' or kind_text contains 'finished'
    echo 'finished'
  elsif title_text contains '完成品' or title_text contains '成品' or title_text contains 'finished'
    echo 'finished'
  else
    echo 'materials'
  endif
-%}
