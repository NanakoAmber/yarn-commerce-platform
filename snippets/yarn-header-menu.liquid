{%- comment -%}Localized flat navigation for the four approved visitor destinations.{%- endcomment -%}
<nav class="header__inline-menu" aria-label="{{ 'sections.header.menu' | t }}">
  <ul class="list-menu list-menu--inline yarn-main-menu" role="list">
    <li><a id="YarnHeaderMenu-home" href="{{ home_url }}" class="header__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'index' %} header__active-menu-item{% endif %}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}><span>{{ home_label | escape }}</span></a></li>
    <li><a id="YarnHeaderMenu-finished" href="{{ finished_url }}" class="header__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'search' and search.terms == 'tag:完成品' %} header__active-menu-item{% endif %}"{% if request.page_type == 'search' and search.terms == 'tag:完成品' %} aria-current="page"{% endif %}><span>{{ finished_label | escape }}</span></a></li>
    <li><a id="YarnHeaderMenu-materials" href="{{ materials_url }}" class="header__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'search' and search.terms == 'tag:毛糸' %} header__active-menu-item{% endif %}"{% if request.page_type == 'search' and search.terms == 'tag:毛糸' %} aria-current="page"{% endif %}><span>{{ materials_label | escape }}</span></a></li>
    <li><a id="YarnHeaderMenu-contact" href="{{ contact_url }}" class="header__menu-item list-menu__item link link--text focus-inset{% if request.page_type == 'page' and page.handle == 'contact' %} header__active-menu-item{% endif %}"{% if request.page_type == 'page' and page.handle == 'contact' %} aria-current="page"{% endif %}><span>{{ contact_label | escape }}</span></a></li>
  </ul>
</nav>
