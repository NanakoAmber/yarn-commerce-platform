{%- comment -%}One specification role across cards. Missing data links readers to product facts; never infer yarn weight from shipping weight.{%- endcomment -%}
{%- if product.metafields.yarn.spec_line.value != blank -%}
  {{- product.metafields.yarn.spec_line.value | escape -}}
{%- elsif product.tags contains '編みものキット' -%}
  {{- 'yarn_project.card_spec_kit' | t -}}
{%- elsif product.tags contains '完成品' -%}
  {{- 'yarn_project.card_spec_finished' | t -}}
{%- else -%}
  {{- 'yarn_project.card_spec_product' | t -}}
{%- endif -%}
