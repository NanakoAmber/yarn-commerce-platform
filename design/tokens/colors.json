    "scrollbar-thumb": {
      "value": "milk-400",
      "use": "滚动条滑块"
    },
    "scrollbar-track": {
      "value": "cream-100",
      "use": "滚动条轨道"
    },
    "shadow-page": {
      "value": "milk-200",
      "use": "配色方案 1 阴影色"
    },
    "shadow-sunken": {
      "value": "milk-200",
      "use": "配色方案 2 阴影色"
    },
    "shadow-inverse": {
      "value": "ink-900",
      "use": "配色方案 3 阴影色"
    },
    "shadow-cream": {
      "value": "milk-200",
      "use": "配色方案 4 阴影色"
    },
    "shadow-warm": {
      "value": "milk-200",
      "use": "配色方案 5 阴影色"
    }
