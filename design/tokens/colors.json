{
  "$comment": "唯一颜色源。修改后运行 npm run tokens 生成 assets/yarn-design-tokens.css 颜色段、config/settings_data.json 的 color_schemes 与 DESIGN.md 颜色 YAML。页面只能引用 roles；palette 只在本文件内被 roles 引用。",
  "palette": {
    "cloud-dancer": "#f0eee9",
    "white": "#ffffff",
    "celadon-200": "#dde5dc",
    "celadon-300": "#c3cdc2",
    "celadon-400": "#a9c4b1",
    "celadon-500": "#93b39d",
    "celadon-600": "#83a38f",
    "slate-500": "#7a7d73",
    "slate-700": "#4f5a53",
    "slate-800": "#414b45",
    "slate-900": "#27302b",
    "ochre-500": "#9d5c25",
    "ochre-700": "#7e4718",
    "ochre-800": "#633812",
    "blush-100": "#f2dcd4",
    "linen-100": "#f0e1c3",
    "indigo-600": "#3d6a8c"
