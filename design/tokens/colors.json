{
  "$comment": "唯一颜色源。修改后运行 npm run tokens 生成 assets/yarn-design-tokens.css 颜色段、config/settings_data.json 的 color_schemes 与 DESIGN.md 颜色 YAML。页面只能引用 roles；palette 只在本文件内被 roles 引用。",
  "palette": {
    "cream-100": "#f7f1e6",
    "white": "#ffffff",
    "milk-100": "#efe4d3",
    "milk-200": "#e3d5c2",
    "milk-400": "#d8b99a",
    "milk-500": "#cba784",
    "tea-700": "#7d583c",
    "tea-800": "#5f432e",
    "ink-900": "#3b2f2a",
    "ink-700": "#54463d",
    "ink-500": "#6c5d52",
    "ink-300": "#9a8b7e",
    "paw-100": "#f8dedb",
    "paw-200": "#f2b8b5",
    "paw-600": "#c96f6f",
    "lake-100": "#dcebe7",
    "lake-700": "#3f7a73"
  },
  "roles": {
    "bg-page": {
      "value": "cream-100",
      "use": "页面底（奶白）"
    },
    "bg-surface": {
      "value": "white",
      "use": "卡片、导航、横幅、输入框面"
    },
    "bg-sunken": {
      "value": "milk-100",
      "use": "次级区块（浅奶茶）"
    },
    "bg-warm": {
      "value": "milk-100",
      "use": "配色方案 5 区块（与 bg-sunken 相同）"
    },
    "bg-inverse": {
      "value": "tea-800",
      "use": "深色反白区块"
    },
    "text-primary": {
      "value": "ink-900",
      "use": "正文、通用标题、Rise 原生文字（暖深棕黑）"
    },
    "text-heading": {
      "value": "ink-900",
      "use": "商品家族标题（与 text-primary 相同）"
    },
    "text-warm": {
      "value": "ink-900",
      "use": "配色方案 5 文字（与 text-primary 相同）"
    },
    "text-secondary": {
      "value": "ink-700",
      "use": "次级正文"
    },
    "text-muted": {
      "value": "ink-500",
      "use": "辅助说明、规格、元信息"
    },
    "text-disabled": {
      "value": "ink-300",
      "use": "不可用文字"
    },
    "text-inverse": {
      "value": "white",
      "use": "深色区块上的文字"
    },
    "text-on-action": {
      "value": "white",
      "use": "深奶茶实心按钮上的文字"
    },
    "text-on-cta": {
      "value": "ink-900",
      "use": "浅奶茶主按钮与爪子粉面上的文字"
    },
    "action": {
      "value": "tea-700",
      "use": "链接、文字按钮、价格（深奶茶）"
    },
    "accent": {
      "value": "tea-700",
      "use": "价格等强调文字（与 action 相同）"
    },
    "action-fill": {
      "value": "tea-700",
      "use": "实心按钮、选中色块、购物车气泡的底色（深奶茶）"
    },
    "action-strong": {
      "value": "tea-800",
      "use": "按下态、深色强调"
    },
    "action-subtle-bg": {
      "value": "milk-100",
      "use": "浅色操作面：导航选中、帮助、页脚"
    },
    "action-subtle-hover": {
      "value": "milk-200",
      "use": "浅色操作面的悬停"
    },
    "cta-bg": {
      "value": "milk-400",
      "use": "主按钮：加购、Hero 主按钮、选中筛选（浅奶茶）"
    },
    "cta-hover": {
      "value": "milk-500",
      "use": "主按钮悬停"
    },
    "cta-border": {
      "value": "milk-500",
      "use": "主按钮与浅色胶囊边线"
