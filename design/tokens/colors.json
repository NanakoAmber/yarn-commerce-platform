      "button_label": "bg-inverse",
      "secondary_button_label": "text-inverse",
      "shadow": "shadow-inverse"
    },
    "scheme-4": {
      "name": "浅色操作面",
      "background": "action-subtle-bg",
      "text": "text-primary",
      "button": "action-fill",
      "button_label": "text-on-action",
      "secondary_button_label": "action",
      "shadow": "shadow-cream"
