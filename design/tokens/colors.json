    },
    "border-disabled": {
      "value": "milk-200",
      "use": "不可用控件边线"
    },
    "tint-butter": {
      "value": "milk-100",
      "use": "柔色面：编织包角标、信息卡"
    },
    "tint-blush": {
      "value": "paw-100",
      "use": "柔色面：毛线角标、信息卡（爪子粉）"
    },
    "tint-sage": {
      "value": "lake-100",
      "use": "柔色面：成品角标、信息卡（湖绿）"
    },
    "selected-text": {
      "value": "tea-700",
      "use": "作品筛选选中态（与 action 相同）"
    },
    "focus": {
      "value": "lake-700",
      "use": "键盘焦点环、输入光标（猫眼湖绿）"
    },
    "decor-paw": {
      "value": "paw-200",
      "use": "爪子粉点缀：首屏轮播箭头；不得用于文字"
    },
    "favorite": {
      "value": "paw-600",
      "use": "已收藏的爱心（图形，≥3:1）；不得用于文字"
    },
    "decor-thread": {
      "value": "milk-500",
      "use": "插画连线、装饰描边；不得用于文字"
    },
    "decor-art-line": {
      "value": "milk-400",
      "use": "插画节点描边；不得用于文字"
    },
    "decor-wave": {
      "value": "milk-100",
      "use": "Hero 底部波浪；随背景变化"
    },
    "decor-halo": {
      "value": "milk-400",
      "use": "插画节点光晕",
      "alpha": 0.45
    },
    "overlay": {
      "value": "ink-900",
      "use": "抽屉与弹窗遮罩、浮层阴影",
      "alpha": 0.32
    },
    "shadow-soft": {
      "value": "ink-900",
      "use": "卡片与浮层的柔和阴影",
      "alpha": 0.14
