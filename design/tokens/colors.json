  "schemes": {
    "scheme-1": {
      "name": "默认页面",
      "background": "bg-page",
      "text": "text-primary",
      "button": "action-fill",
      "button_label": "text-on-action",
      "secondary_button_label": "action",
      "shadow": "shadow-page"
    },
    "scheme-2": {
      "name": "次级浅奶茶",
      "background": "bg-sunken",
      "text": "text-primary",
      "button": "action-fill",
      "button_label": "text-on-action",
      "secondary_button_label": "action",
      "shadow": "shadow-sunken"
    },
    "scheme-3": {
