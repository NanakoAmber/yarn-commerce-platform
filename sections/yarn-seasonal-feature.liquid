{% liquid
  assign seasonal_heading = section.settings.heading
  assign seasonal_text = section.settings.text
  assign seasonal_button = section.settings.button_label

  assign seasonal_button_link = section.settings.button_link | default: routes.all_products_collection_url
  case request.locale.iso_code
    when 'zh-CN', 'zh'

      assign seasonal_heading = section.settings.heading_zh
      assign seasonal_text = section.settings.text_zh
      assign seasonal_button = section.settings.button_zh
    when 'en'

      assign seasonal_heading = section.settings.heading_en
      assign seasonal_text = section.settings.text_en
      assign seasonal_button = section.settings.button_en
  endcase

  if section.settings.button_link contains 'discover-products'
    assign seasonal_button_link = routes.root_url | append: '?discover_season=cold#discover-products'
  endif
%}

<section class="yarn-seasonal color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="yarn-seasonal__frame">
      <div class="yarn-seasonal__media" aria-hidden="true">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '420, 750, 1000, 1400', sizes: '(min-width: 750px) 60vw, 100vw', alt: '' }}
        {% else %}
        <img
          src="{{ 'yarn-hero-editorial.png' | asset_url }}"
          alt=""
          width="1536"
          height="1024"
          loading="lazy"
        >
        {% endif %}
      </div>

      <div class="yarn-seasonal__content">
        <h2>{{ seasonal_heading | escape }}</h2>
        <div class="yarn-seasonal__text rte">{{ seasonal_text }}</div>
        {% if seasonal_button != blank %}
          <a class="yarn-seasonal__link" href="{{ seasonal_button_link }}">
            {{ seasonal_button | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-seasonal.yarn-seasonal {
    padding: clamp(72px, 8vw, 116px) 0;
    background: #f9f5f0;
  }

  .yarn-seasonal__frame {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.65fr);
    min-height: 540px;
    overflow: hidden;
    border: 1px solid rgba(177, 166, 149, 0.22);
    border-radius: 28px;
    background: #fffefa;
    box-shadow: 0 20px 54px rgba(112, 94, 73, 0.07);
  }

  .yarn-seasonal__media {
    min-height: 540px;
    overflow: hidden;
    background: #edf3f3;
  }

  .yarn-seasonal__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .yarn-seasonal__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(40px, 5vw, 72px) clamp(40px, 5vw, 72px);
    color: #2b2925;
  }

  .yarn-seasonal__eyebrow {
    margin: 0 0 18px;
    color: #d88276;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .yarn-seasonal__content h2 {
    max-width: 9em;
    margin: 0;
    font-size: clamp(3.2rem, 3.5vw, 5rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .yarn-seasonal__text {
    max-width: 34rem;
    margin-top: 20px;
    color: #65645f;
    font-size: 1.5rem;
    line-height: 1.8;
  }

  .yarn-seasonal__text p {
    margin: 0;
  }

  .yarn-seasonal__link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 28px;
    padding-bottom: 5px;
    border-bottom: 1px solid #d88276;
    color: #353633;
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media screen and (max-width: 989px) {
    .yarn-seasonal__frame { grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr); }

    .yarn-seasonal__media {
      min-height: 420px;
    }

    .yarn-seasonal__content { padding: clamp(36px, 7vw, 58px); }
  }

  @media screen and (max-width: 749px) {
    .yarn-seasonal {
      padding: 56px 0 64px;
    }

    .yarn-seasonal__frame {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 20px;
    }

    .yarn-seasonal__media {
      min-height: 280px;
    }

    .yarn-seasonal__content {
      padding: 30px 24px 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "季节主题推荐",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "当季灵感图片" },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "季節の色を、ひとつずつ重ねる。"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "说明",
      "default": "<p>軽やかなコットンから、深みのある段染めまで。いま編みたい作品に合う、季節の毛糸とキットを集めました。</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮",
      "default": "季節のおすすめを見る"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "链接"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading_zh",
      "label": "中文 · heading",
      "default": "秋冬适合的线与作品"
    },
    {
      "type": "richtext",
      "id": "text_zh",
      "label": "中文 · text",
      "default": "<p>从天气与穿着场景出发，看看适合秋冬的毛线与毯子套件。</p>"
    },
    {
      "type": "text",
      "id": "button_zh",
      "label": "中文 · button",
      "default": "查看秋冬作品"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "英文 · heading",
      "default": "Yarn and projects for cooler days"
    },
    {
      "type": "richtext",
      "id": "text_en",
      "label": "英文 · text",
      "default": "<p>Explore yarn and blanket kits for cooler days.</p>"
    },
    {
      "type": "text",
      "id": "button_en",
      "label": "英文 · button",
      "default": "View autumn and winter projects"
    }
  ],
  "presets": [
    {
      "name": "季节主题推荐"
    }
  ]
}
{% endschema %}
