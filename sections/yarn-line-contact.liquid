{% liquid
  assign line_heading = section.settings.heading
  assign line_text = section.settings.text
  assign line_primary = section.settings.primary_label
  assign line_secondary = section.settings.secondary_label
  assign line_has_primary = false
  if section.settings.primary_link != blank
    assign line_has_primary = true
  endif
  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign line_heading = section.settings.heading_zh
      assign line_text = section.settings.text_zh
      assign line_primary = section.settings.primary_zh
      assign line_secondary = section.settings.secondary_zh
    when 'en'
      assign line_heading = section.settings.heading_en
      assign line_text = section.settings.text_en
      assign line_primary = section.settings.primary_en
      assign line_secondary = section.settings.secondary_en
  endcase

  unless line_has_primary
    assign line_heading = section.settings.fallback_heading
    assign line_text = section.settings.fallback_text
    case request.locale.iso_code
      when 'zh-CN', 'zh'
        assign line_heading = section.settings.heading_zh_fallback
        assign line_text = section.settings.text_zh_fallback
        assign line_secondary = section.settings.secondary_zh_fallback
      when 'en'
        assign line_heading = section.settings.heading_en_fallback
        assign line_text = section.settings.text_en_fallback
        assign line_secondary = section.settings.secondary_en_fallback
    endcase
  endunless
%}

<section id="line-support" class="yarn-line color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="yarn-line__inner">
      <img class="yarn-line__flourish" src="{{ 'impeccable-next-section-flourish.png' | asset_url }}" alt="" width="1024" height="512" loading="lazy">
      <div class="yarn-line__copy">
        <h2>{{ line_heading | escape }}</h2>
        <div class="rte">{{ line_text }}</div>
      </div>
      <div class="yarn-line__actions">
        {% if line_has_primary %}
          <a class="button yarn-line__primary" href="{{ section.settings.primary_link }}">
            {{ line_primary | escape }}
          </a>
          <a class="yarn-line__secondary" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }} <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {% else %}
          <a class="button yarn-line__fallback" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-line.yarn-line {
    padding: clamp(64px, 7vw, 100px) 0;
    background: #f5f7f3;
    color: #2b2d2b;
  }

  .yarn-line__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 7vw, 108px);
    align-items: center;
    overflow: hidden;
    padding: clamp(42px, 6vw, 82px);
    border: 1px solid rgba(135, 174, 181, 0.22);
    border-radius: 28px;
    background: #edf5f7;
    box-shadow: 0 20px 54px rgba(88, 119, 125, 0.07);
  }

  .yarn-line__flourish {
    position: absolute;
    right: -7%;
    bottom: -31%;
    width: min(48%, 590px);
    height: auto;
    opacity: 0.38;
    pointer-events: none;
  }

  .yarn-line__copy,
  .yarn-line__actions { position: relative; z-index: 1; }

  .yarn-line__copy h2 {
    margin: 0;
    max-width: 15em;
    color: #292b29;
    font-size: clamp(3rem, 3.3vw, 4.8rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .yarn-line__copy .rte {
    max-width: 54rem;
    margin-top: 14px;
    color: #5f6260;
    font-size: 1.5rem;
    line-height: 1.8;
  }

  .yarn-line__copy .rte p {
    margin: 0;
  }

  .yarn-line__actions {
    display: flex;
    min-width: 200px;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .yarn-line .yarn-line__primary {
    border-radius: 999px;
    border-color: #cee6d5;
    background: #cee6d5;
    color: #294333;
  }

  .yarn-line .yarn-line__fallback {
    border-radius: 999px;
    border-color: #f7e3a5;
    background: #f7e3a5;
    color: #292a28;
  }

  .yarn-line__secondary {
    color: #343b3c;
    font-size: 1.3rem;
    text-align: center;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .yarn-line__secondary span,
  .yarn-line__secondary svg {
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: -2px;
  }

  @media screen and (max-width: 989px) {
    .yarn-line__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media screen and (max-width: 749px) {
    .yarn-line__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 34px 24px;
      border-radius: 20px;
    }

    .yarn-line__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
{% endstylesheet %}

