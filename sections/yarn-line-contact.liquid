{% liquid
  assign line_mark = '相談'
  assign line_heading = section.settings.heading
  assign line_text = section.settings.text
  assign line_primary = section.settings.primary_label
  assign line_secondary = section.settings.secondary_label
  assign line_has_primary = false
  if section.settings.primary_link != blank
    assign line_has_primary = true
  endif
  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign line_mark = '咨询'
      assign line_heading = '通过 LINE，聊聊怎么选毛线。'
      assign line_text = '<p>库存、配色、作品用量等问题，都可以在下单前轻松咨询。</p>'
      assign line_primary = '通过 LINE 咨询'
      assign line_secondary = '联系我们'
    when 'en'
      assign line_mark = 'ASK'
      assign line_heading = 'Talk yarn with us on LINE.'
      assign line_text = '<p>Ask about stock, colour combinations or how much yarn your project needs before you order.</p>'
      assign line_primary = 'Ask on LINE'
      assign line_secondary = 'Contact us'
  endcase

  unless line_has_primary
    assign line_heading = '迷ったら、つくりたいものからご相談ください。'
    assign line_text = '<p>色合わせや必要量、在庫で迷ったときは、お問い合わせフォームから気軽にお知らせください。</p>'
    case request.locale.iso_code
      when 'zh-CN', 'zh'
        assign line_heading = '还没决定？先聊聊你想做的作品。'
        assign line_text = '<p>配色、用量或库存不确定时，可以先通过联系表单告诉我们。</p>'
        assign line_secondary = '联系我们'
      when 'en'
        assign line_heading = 'Not sure yet? Tell us what you want to make.'
        assign line_text = '<p>If you are unsure about colour, quantity or stock, send us a note through the contact form.</p>'
        assign line_secondary = 'Contact us'
    endcase
  endunless
%}

<section id="line-support" class="yarn-line color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="yarn-line__inner">
      <div class="yarn-line__mark" aria-hidden="true">
        <span>{{ line_mark }}</span>
      </div>
      <div class="yarn-line__copy">
        <h2>{{ line_heading | escape }}</h2>
        <div class="rte">{{ line_text }}</div>
      </div>
      <div class="yarn-line__actions">
        {% if line_has_primary %}
          <a class="button yarn-line__primary" href="{{ section.settings.primary_link }}">
            {{ line_primary | escape }}
          </a>
          <a class="yarn-line__secondary" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }} <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {% else %}
          <a class="button yarn-line__fallback" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-line {
    padding: clamp(44px, 6vw, 80px) 0;
  }

  .yarn-line__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(26px, 5vw, 72px);
    align-items: center;
    padding: clamp(36px, 5vw, 64px);
    border: 1px solid rgba(120, 185, 216, 0.24);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.62);
  }

  .yarn-line__mark {
    display: grid;
    width: 112px;
    height: 112px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50% 48% 52% 46%;
    transform: rotate(-5deg);
  }

  .yarn-line__mark span {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    transform: rotate(5deg);
  }

  .yarn-line__copy h2 {
    margin: 0;
    font-size: clamp(2.8rem, 3.4vw, 4.6rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .yarn-line__copy .rte {
    max-width: 58rem;
    margin-top: 18px;
    font-size: 1.4rem;
    line-height: 1.75;
  }

  .yarn-line__copy .rte p {
    margin: 0;
  }

  .yarn-line__actions {
    display: flex;
    min-width: 210px;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .yarn-line__primary {
    border-color: #06c755;
    background: #06c755;
    color: #ffffff;
  }

  .yarn-line__fallback {
    border-color: #7d9064;
    background: #7d9064;
    color: #ffffff;
  }

  .yarn-line__secondary {
    color: inherit;
    font-size: 1.3rem;
    text-align: center;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .yarn-line__secondary span,
  .yarn-line__secondary svg {
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: -2px;
  }

  @media screen and (max-width: 989px) {
    .yarn-line__inner {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .yarn-line__actions {
      grid-column: 2;
      min-width: 0;
      flex-direction: row;
      align-items: center;
    }
  }

  @media screen and (max-width: 749px) {
    .yarn-line__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 32px 24px;
      border-radius: 14px;
    }

    .yarn-line__mark {
      width: 78px;
      height: 78px;
    }

    .yarn-line__actions {
      grid-column: 1;
      flex-direction: column;
      align-items: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LINE 咨询入口",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "糸選びの相談を、LINEで。" },
    { "type": "richtext", "id": "text", "label": "说明", "default": "<p>在庫、色合わせ、作品に必要な量など。選ぶ前に確認したいことを、気軽にご相談いただけます。</p>" },
    { "type": "text", "id": "primary_label", "label": "主按钮", "default": "LINEで相談する" },
    { "type": "url", "id": "primary_link", "label": "LINE 链接" },
    { "type": "text", "id": "secondary_label", "label": "次链接", "default": "お問い合わせ" },
    { "type": "url", "id": "secondary_link", "label": "联系页链接" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-3" }
  ],
  "presets": [
    { "name": "LINE 咨询入口" }
  ]
}
{% endschema %}
