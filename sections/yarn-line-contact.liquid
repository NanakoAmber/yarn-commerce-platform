{% liquid
  assign line_heading = section.settings.heading
  assign line_text = section.settings.text
  assign line_primary = section.settings.primary_label
  assign line_secondary = section.settings.secondary_label
  assign line_has_primary = false
  if section.settings.primary_link != blank
    assign line_has_primary = true
  endif
  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign line_heading = section.settings.heading_zh
      assign line_text = section.settings.text_zh
      assign line_primary = section.settings.primary_zh
      assign line_secondary = section.settings.secondary_zh
    when 'en'
      assign line_heading = section.settings.heading_en
      assign line_text = section.settings.text_en
      assign line_primary = section.settings.primary_en
      assign line_secondary = section.settings.secondary_en
  endcase

  unless line_has_primary
    assign line_heading = section.settings.fallback_heading
    assign line_text = section.settings.fallback_text
    case request.locale.iso_code
      when 'zh-CN', 'zh'
        assign line_heading = section.settings.heading_zh_fallback
        assign line_text = section.settings.text_zh_fallback
        assign line_secondary = section.settings.secondary_zh_fallback
      when 'en'
        assign line_heading = section.settings.heading_en_fallback
        assign line_text = section.settings.text_en_fallback
        assign line_secondary = section.settings.secondary_en_fallback
    endcase
  endunless
  if section.settings.compact_layout
    assign line_heading = section.settings.compact_heading
    assign line_secondary = section.settings.compact_action
    case request.locale.iso_code
      when 'zh', 'zh-CN'
        assign line_heading = section.settings.compact_heading_zh
        assign line_secondary = section.settings.compact_action_zh
      when 'en'
        assign line_heading = section.settings.compact_heading_en
        assign line_secondary = section.settings.compact_action_en
    endcase
  endif
%}

<section id="line-support" class="yarn-line{% if section.settings.compact_layout %} yarn-line--compact{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="yarn-line__inner">
      {% if section.settings.compact_layout %}<img class="yarn-line__help-icon" src="{{ 'impeccable-b-help-icon.png' | asset_url }}" alt="" width="1254" height="1254" loading="lazy">{% else %}<img class="yarn-line__flourish" src="{{ 'impeccable-next-section-flourish.png' | asset_url }}" alt="" width="1024" height="512" loading="lazy">{% endif %}
      <div class="yarn-line__copy">
        <h2>{{ line_heading | escape }}</h2>
        {% unless section.settings.compact_layout %}<div class="rte">{{ line_text }}</div>{% endunless %}
      </div>
      <div class="yarn-line__actions">
        {% if line_has_primary %}
          <a class="button yarn-line__primary" href="{{ section.settings.primary_link }}">
            {{ line_primary | escape }}
          </a>
          <a class="yarn-line__secondary" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }} <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {% else %}
          <a class="button yarn-line__fallback" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }}{% if section.settings.compact_layout %}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>{% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-line.yarn-line {
    padding: clamp(64px, 7vw, 100px) 0;
    background: #f5f7f3;
    color: #2b2d2b;
  }

  .yarn-line__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 7vw, 108px);
    align-items: center;
    overflow: hidden;
    padding: clamp(42px, 6vw, 82px);
    border: 1px solid rgba(135, 174, 181, 0.22);
    border-radius: 28px;
    background: #edf5f7;
    box-shadow: 0 20px 54px rgba(88, 119, 125, 0.07);
  }

  .yarn-line__flourish {
    position: absolute;
    right: -7%;
    bottom: -31%;
    width: min(48%, 590px);
    height: auto;
    opacity: 0.38;
    pointer-events: none;
  }

  .yarn-line__copy,
  .yarn-line__actions { position: relative; z-index: 1; }

  .yarn-line__copy h2 {
    margin: 0;
    max-width: 15em;
    color: #292b29;
    font-size: clamp(3rem, 3.3vw, 4.8rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .yarn-line__copy .rte {
    max-width: 54rem;
    margin-top: 14px;
    color: #5f6260;
    font-size: 1.5rem;
    line-height: 1.8;
  }

  .yarn-line__copy .rte p {
    margin: 0;
  }

  .yarn-line__actions {
    display: flex;
    min-width: 200px;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .yarn-line .yarn-line__primary {
    border-radius: 999px;
    border-color: #cee6d5;
    background: #cee6d5;
    color: #294333;
  }

  .yarn-line .yarn-line__fallback {
    border-radius: 999px;
    border-color: #f7e3a5;
    background: #f7e3a5;
    color: #292a28;
  }

  .yarn-line__secondary {
    color: #343b3c;
    font-size: 1.3rem;
    text-align: center;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .yarn-line__secondary span,
  .yarn-line__secondary svg {
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: -2px;
  }

  @media screen and (max-width: 989px) {
    .yarn-line__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media screen and (max-width: 749px) {
    .yarn-line__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 34px 24px;
      border-radius: 20px;
    }

    .yarn-line__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
  .section:has(.yarn-line--compact) { margin-top: 0; }
  .yarn-line.yarn-line--compact { padding: 28px 0 36px; background: #fffefa; }
  .yarn-line--compact > .page-width { width: min(1160px, calc(100% - 64px)); max-width: none; padding: 0; }
  .yarn-line--compact .yarn-line__inner { grid-template-columns: 58px minmax(0, 1fr) auto; padding: 24px 30px; gap: 22px; min-height: 110px; border: 0; border-radius: 16px; box-shadow: none; }
  .yarn-line__help-icon { display: block; width: 58px; height: 58px; object-fit: contain; mix-blend-mode: multiply; }
  .yarn-line--compact .yarn-line__copy h2 { font-size: 2rem; line-height: 1.4; }
  .yarn-line--compact .yarn-line__actions { min-width: 0; }
  .yarn-line--compact .yarn-line__fallback { padding: 8px 0; min-height: 44px; gap: 14px; background: transparent; border: 0; border-radius: 0; color: #343d3c; font-size: 1.5rem; box-shadow: none; }
  .yarn-line--compact .yarn-line__fallback::before, .yarn-line--compact .yarn-line__fallback::after { display: none; }
  .yarn-line--compact .yarn-line__fallback:hover { text-decoration: underline; text-underline-offset: 5px; }
  .yarn-line--compact .yarn-line__fallback svg { width: 16px; height: 16px; }
  @media (max-width: 989px) { .yarn-line--compact > .page-width { width: calc(100% - 14%); } }
  @media (max-width: 599px) {
    .yarn-line--compact > .page-width { width: calc(100% - 32px); }
    .yarn-line--compact .yarn-line__inner { grid-template-columns: 32px minmax(0, 1fr) auto; gap: 12px; padding: 18px 16px; min-height: 90px; }
    .yarn-line--compact .yarn-line__copy h2 { font-size: 1.6rem; }
    .yarn-line--compact .yarn-line__fallback { font-size: 1.4rem; gap: 8px; }
    .yarn-line__help-icon { width: 36px; height: 36px; }
  }
{% endstylesheet %}

