{{ 'impeccable-hero-textile.png' | asset_url | preload_tag: as: 'image' }}

{% liquid
  assign hero_heading = section.settings.heading
  assign hero_text = section.settings.text
  assign flow_select = section.settings.flow_select
  assign flow_buy = section.settings.flow_buy
  assign flow_make = section.settings.flow_make

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign hero_heading = section.settings.heading_zh
      assign hero_text = section.settings.text_zh
      assign flow_select = section.settings.flow_select_zh
      assign flow_buy = section.settings.flow_buy_zh
      assign flow_make = section.settings.flow_make_zh
    when 'en'
      assign hero_heading = section.settings.heading_en
      assign hero_text = section.settings.text_en
      assign flow_select = section.settings.flow_select_en
      assign flow_buy = section.settings.flow_buy_en
      assign flow_make = section.settings.flow_make_en
  endcase
%}

<section class="yarn-hero color-{{ section.settings.color_scheme }} gradient" aria-labelledby="YarnHeroHeading-{{ section.id }}">
  <div class="yarn-hero__visual">
    <div class="yarn-hero__paper" aria-hidden="true" style="background-image: url('{{ 'impeccable-page-paper.png' | asset_url }}');"></div>
    <img class="yarn-hero__notation" src="{{ 'impeccable-hero-notation-doodles.png' | asset_url }}" alt="" width="1024" height="1536" loading="eager">
    <span class="yarn-hero__flowers" aria-hidden="true"><img src="{{ 'impeccable-hero-notation-doodles.png' | asset_url }}" alt="" width="1024" height="1536" loading="eager"></span>
    <img class="yarn-hero__textile" src="{{ 'impeccable-hero-textile.png' | asset_url }}" alt="" width="682" height="1476" loading="eager" fetchpriority="high">

    <div class="yarn-hero__copy">
      <h1 id="YarnHeroHeading-{{ section.id }}" class="yarn-hero__heading" lang="{{ request.locale.iso_code }}">{{ hero_heading | escape }}</h1>
      {% if hero_text != blank %}<div class="yarn-hero__text rte">{{ hero_text }}</div>{% endif %}
    </div>
  </div>

  <ol class="yarn-hero__flow" aria-label="{{ flow_select | escape }} → {{ flow_buy | escape }} → {{ flow_make | escape }}">
    <li class="yarn-hero__step">
      <span class="yarn-hero__step-art"><img src="{{ 'impeccable-flow-select-plate.png' | asset_url }}" alt="" width="512" height="738" loading="eager"></span>
      <strong>{{ flow_select | escape }}</strong>
    </li>
    <li class="yarn-hero__step">
      <span class="yarn-hero__step-art"><img src="{{ 'impeccable-flow-buy-plate.png' | asset_url }}" alt="" width="512" height="738" loading="eager"></span>
      <strong>{{ flow_buy | escape }}</strong>
    </li>
    <li class="yarn-hero__step">
      <span class="yarn-hero__step-art"><img src="{{ 'impeccable-flow-make-plate.png' | asset_url }}" alt="" width="682" height="738" loading="eager"></span>
      <strong>{{ flow_make | escape }}</strong>
    </li>
  </ol>
</section>

{% stylesheet %}
  .yarn-hero.yarn-hero {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: #f7f7f5;
    color: #2f302f;
  }

  .yarn-hero__visual {
    position: relative;
    min-height: clamp(500px, 48vw, 690px);
    overflow: hidden;
    background-color: #fbf9f4;
    isolation: isolate;
  }

  .yarn-hero .yarn-hero__paper {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -3;
    background-repeat: repeat;
    background-size: 171px 184px;
    opacity: 1;
    mix-blend-mode: multiply;
  }

  .yarn-hero__notation,
  .yarn-hero__textile {
    position: absolute;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .yarn-hero__notation {
    clip-path: inset(0 0 60% 0);
    mix-blend-mode: multiply;
    z-index: 0;
    top: -6%;
    right: 22%;
    width: min(49vw, 700px);
    height: 100%;
    object-fit: contain;
    object-position: center top;
  }

  .yarn-hero__textile {
    z-index: -1;
    top: -8%;
    right: 0;
    width: min(48vw, 690px);
    height: 116%;
    object-fit: cover;
    object-position: left 44%;
  }

  .yarn-hero__flowers {
    position: absolute;
    z-index: 0;
    top: 49%;
    left: 56%;
    width: 110px;
    height: 205px;
    overflow: hidden;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .yarn-hero__flowers img {
    position: absolute;
    width: 450px;
    max-width: none;
    height: 675px;
    left: -320px;
    top: -250px;
  }

  .yarn-hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 1420px);
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    padding-left: clamp(32px, 5vw, 72px);
    padding-top: clamp(56px, 7vw, 100px);
    padding-right: min(45vw, 650px);
    padding-bottom: clamp(130px, 13vw, 190px);
  }

  .yarn-hero__heading {
    max-width: 9.4em;
    margin: 0;
    color: #2f302f;
    font-family: var(--yarn-display);
    font-size: clamp(4.6rem, 4.5vw, 6.3rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .yarn-hero__text {
    max-width: 29em;
    margin-top: clamp(24px, 2.4vw, 34px);
    color: #424341;
    font-size: clamp(1.65rem, 1.75vw, 2.35rem);
    line-height: 1.85;
  }

  .yarn-hero__text p { margin: 0; }

  .yarn-hero__flow {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(calc(100% - 96px), 1220px);
    min-height: clamp(240px, 25vw, 330px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: clamp(-156px, -10vw, -92px) auto 0;
    padding: clamp(25px, 3vw, 42px) clamp(30px, 4vw, 64px) clamp(24px, 2.5vw, 36px);
    border: 1px solid rgba(173, 163, 149, 0.2);
    border-radius: 24px;
    background: rgba(255, 255, 254, 0.97);
    box-shadow: 0 18px 46px rgba(127, 103, 82, 0.11);
    list-style: none;
  }

  .yarn-hero__step {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .yarn-hero__step:not(:last-child)::after {
    position: absolute;
    top: 33%;
    right: -12px;
    width: 32px;
    height: 24px;
    background: #242625;
    clip-path: polygon(0 45%, 72% 45%, 72% 12%, 100% 50%, 72% 88%, 72% 55%, 0 55%);
    content: '';
  }

  .yarn-hero__step-art {
    display: block;
    width: clamp(120px, 12.5vw, 176px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
  }

  .yarn-hero__step-art img { width: 100%; height: 100%; object-fit: cover; }

  .yarn-hero__step strong {
    font-family: var(--yarn-display);
    margin-top: clamp(12px, 1.4vw, 20px);
    color: #222321;
    font-size: clamp(1.8rem, 2vw, 2.8rem);
    font-weight: 400;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    .yarn-hero__visual { min-height: clamp(390px, 68vw, 580px); }
    .yarn-hero__paper { background-size: 171px 184px; opacity: 1; }
    .yarn-hero__notation { top: -8%; right: 13%; width: 52%; height: 116%; }
    .yarn-hero__flowers { left: 53%; top: 50%; }
    .yarn-hero__textile { top: -44.2%; right: 0; width: 43%; height: 175%; object-position: right top; mask-image: linear-gradient(to right, transparent, black 16%); }
    .yarn-hero__copy { justify-content: flex-start; padding: clamp(116px, 15.1vw, 145px) 33% clamp(78px, 10vw, 96px) 6.3%; }
    .yarn-hero__heading { max-width: 8.7em; font-size: clamp(3.3rem, 7.4vw, 6.3rem); line-height: 1.32; letter-spacing: 0.055em; }
    .yarn-hero__text { max-width: 16em; margin-top: clamp(20px, 2.8vw, 27px); color: #242523; font-size: clamp(1.45rem, 2.8vw, 2.35rem); font-weight: 400; line-height: 1.9; letter-spacing: 0.045em; }
    .yarn-hero__flow {
      width: calc(100% - clamp(40px, 10.8vw, 92px));
      min-height: clamp(210px, 32.2vw, 275px);
      margin-top: clamp(-110px, -12.9vw, -52px);
      padding: clamp(20px, 3vw, 28px) clamp(18px, 4.7vw, 40px) clamp(20px, 3vw, 28px);
      border-radius: clamp(16px, 2.8vw, 24px);
    }
    .yarn-hero__step:not(:last-child)::after { right: clamp(-5px, -0.6vw, -2px); width: clamp(24px, 4.2vw, 36px); height: clamp(14px, 2.6vw, 22px); }
    .yarn-hero__step-art { width: clamp(104px, 17.6vw, 150px); }
    .yarn-hero__step:first-child .yarn-hero__step-art { transform: translate(-27px, -8px); }
    .yarn-hero__step strong { margin-top: clamp(10px, 1.7vw, 15px); font-size: clamp(1.45rem, 3.4vw, 2.9rem); }
  }

  @media screen and (max-width: 599px) {
    .yarn-hero__visual { min-height: 390px; }
    .yarn-hero__notation { right: -2%; width: 78%; opacity: 0.58; }
    .yarn-hero__flowers { display: none; }
    .yarn-hero__textile { top: 0; right: -9%; width: 39%; height: 75%; object-position: left top; }
    .yarn-hero__copy { padding: 58px 26% 100px 24px; }
    .yarn-hero__heading { max-width: 10em; font-size: 3rem; line-height: 1.4; letter-spacing: 0; }
    .yarn-hero__text { max-width: 22em; font-size: 1.45rem; line-height: 1.75; }
    .yarn-hero__flow { width: calc(100% - 28px); min-height: 170px; margin-top: -48px; padding: 18px 8px 20px; border-radius: 18px; }
    .yarn-hero__step-art { width: min(25vw, 96px); }
    .yarn-hero__step:first-child .yarn-hero__step-art { transform: translateX(-7px); }
    .yarn-hero__step strong { font-size: 1.35rem; }
    .yarn-hero__step:not(:last-child)::after { right: -2px; width: 18px; height: 12px; }
  }
{% endstylesheet %}

{% schema %}
