{{ 'yarn-hero-sky-garden.png' | asset_url | preload_tag: as: 'image' }}

{% liquid
  assign hero_eyebrow = section.settings.eyebrow
  assign hero_eyebrow = 'この夏、持ち歩く花畑'
  assign hero_heading = 'やさしい色で、毎日にときめきを。'
  assign hero_heading_lead = 'やさしい色で、'
  assign hero_heading_trail = '毎日にときめきを。'
  assign hero_text = '<p>花モチーフの手編みバッグと、軽やかな季節の毛糸。毎日に小さなときめきを。</p>'
  assign hero_primary = section.settings.primary_label
  assign hero_secondary = section.settings.secondary_label
  assign hero_note_1 = '厳選した毛糸'
  assign hero_note_2 = '編み物キット'
  assign hero_note_3 = '全国配送'

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign hero_eyebrow = '把夏日花园带在身边'
      assign hero_heading = '用温柔的色彩，点亮每一天。'
      assign hero_heading_lead = '用温柔的色彩，'
      assign hero_heading_trail = '点亮每一天。'
      assign hero_text = '<p>花朵手编包与清新的当季毛线，为每一天增添一点心动。</p>'
      assign hero_primary = '按作品挑选'
      assign hero_secondary = '浏览毛线'
      assign hero_note_1 = '精选毛线'
      assign hero_note_2 = '编织套装'
      assign hero_note_3 = '日本全国配送'
    when 'en'
      assign hero_eyebrow = 'Carry a little summer garden'
      assign hero_heading = 'Soft colours for everyday delight.'
      assign hero_heading_lead = 'Soft colours for'
      assign hero_heading_trail = 'everyday delight.'
      assign hero_text = '<p>Floral bags and fresh seasonal yarns for a little everyday delight.</p>'
      assign hero_primary = 'Shop by project'
      assign hero_secondary = 'Browse yarn'
      assign hero_note_1 = 'Curated yarns'
      assign hero_note_2 = 'Knitting kits'
      assign hero_note_3 = 'Delivery across Japan'
  endcase
%}

<section class="yarn-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="yarn-hero__media" aria-hidden="true">
    <img
      src="{{ 'yarn-hero-sky-garden.png' | asset_url }}"
      alt=""
      width="1672"
      height="941"
      loading="eager"
      fetchpriority="high"
    >
  </div>

  <div class="yarn-hero__veil"></div>

  <div class="yarn-hero__content page-width">
    {% if hero_eyebrow != blank %}
      <p class="yarn-hero__eyebrow">{{ hero_eyebrow | escape }}</p>
    {% endif %}

    <h1 class="yarn-hero__heading" lang="{{ request.locale.iso_code }}" aria-label="{{ hero_heading | escape }}">
      <span>{{ hero_heading_lead | escape }}</span>
      <span>{{ hero_heading_trail | escape }}</span>
    </h1>

    {% if hero_text != blank %}
      <div class="yarn-hero__text rte">{{ hero_text }}</div>
    {% endif %}

    <div class="yarn-hero__actions">
      {% if hero_primary != blank %}
        <a class="button button--primary" href="{{ section.settings.primary_link | default: '#shop-by-project' }}">
          {{ hero_primary | escape }}
        </a>
      {% endif %}

      {% if hero_secondary != blank %}
        <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">
          {{ hero_secondary | escape }}
        </a>
      {% endif %}
    </div>

    <ul class="yarn-hero__notes" role="list">
      <li>{{ hero_note_1 }}</li>
      <li>{{ hero_note_2 }}</li>
      <li>{{ hero_note_3 }}</li>
    </ul>
  </div>
</section>

{% stylesheet %}
  .yarn-hero {
    --yarn-ink: #403c3b;
    --yarn-paper: #fffefb;
    --yarn-rose: #f2a6b5;
    --yarn-sky: #78b9d8;
    position: relative;
    isolation: isolate;
    min-height: clamp(430px, 42vw, 560px);
    overflow: hidden;
    color: var(--yarn-ink);
  }

  .yarn-hero__media,
  .yarn-hero__veil {
    position: absolute;
    inset: 0;
  }

  .yarn-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .yarn-hero__veil {
    z-index: 1;
    background: rgba(255, 255, 255, 0.04);
  }

  .yarn-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: clamp(48px, 6vw, 76px);
    padding-bottom: clamp(44px, 5vw, 68px);
  }

  .yarn-hero__eyebrow {
    margin: 0 0 18px;
    color: #4b89ab;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .yarn-hero__heading {
    max-width: 11em;
    margin: 0;
    font-size: clamp(3.8rem, 4.4vw, 5.8rem);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: 0.02em;
  }

  .yarn-hero__heading span {
    display: block;
    white-space: nowrap;
  }

  .yarn-hero__text {
    max-width: 39rem;
    margin-top: 20px;
    font-size: clamp(1.4rem, 1.2vw, 1.65rem);
    line-height: 1.9;
  }

  .yarn-hero__text p {
    margin: 0;
  }

  .yarn-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .yarn-hero__actions .button {
    min-width: 16rem;
    min-height: 4.8rem;
  }

  .yarn-hero__notes {
    display: none;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin: 42px 0 0;
    padding: 0;
    list-style: none;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
  }

  .yarn-hero__notes li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .yarn-hero__notes li::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yarn-rose);
    content: '';
  }

  @media screen and (max-width: 749px) {
    .yarn-hero {
      display: flex;
      min-height: 0;
      flex-direction: column;
      background: #f1f9fd;
    }

    .yarn-hero__media {
      position: relative;
      order: 2;
      height: 330px;
    }

    .yarn-hero__media img {
      object-position: 63% bottom;
    }

    .yarn-hero__veil {
      display: none;
    }

    .yarn-hero .yarn-hero__content {
      order: 1;
      min-height: 0;
      justify-content: flex-start;
      padding-top: 30px;
      padding-bottom: 32px;
    }

    .yarn-hero__heading {
      max-width: none;
      max-width: 8em;
      font-size: clamp(28px, 8.4vw, 36px);
      line-height: 1.24;
    }

    .yarn-hero__heading span {
      white-space: nowrap;
    }

    .yarn-hero__heading[lang='en'] span {
      white-space: normal;
    }

    .yarn-hero__text {
      max-width: 31rem;
      font-size: 1.4rem;
    }

    .yarn-hero__actions {
      width: 100%;
      margin-top: 20px;
    }

    .yarn-hero__actions .button:nth-child(2) {
      display: none;
    }

    .yarn-hero__actions .button {
      flex: 1 1 14rem;
      min-width: 0;
    }

    .yarn-hero__notes {
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .yarn-hero__media img {
      animation: yarn-hero-arrive 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .yarn-hero__content > * {
      animation: yarn-copy-arrive 0.7s ease-out both;
    }

    .yarn-hero__content > :nth-child(2) { animation-delay: 80ms; }
    .yarn-hero__content > :nth-child(3) { animation-delay: 140ms; }
    .yarn-hero__content > :nth-child(4) { animation-delay: 200ms; }
    .yarn-hero__content > :nth-child(5) { animation-delay: 260ms; }
  }

  @keyframes yarn-hero-arrive {
    from { transform: scale(1.035); opacity: 0.6; }
    to { transform: scale(1); opacity: 1; }
  }

  @keyframes yarn-copy-arrive {
    from { transform: translateY(14px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "毛线品牌主视觉",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "YARN · KIT · STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "編みたいものから、毛糸を選ぶ。"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "说明",
      "default": "<p>世界から選んだ毛糸と、すぐに始められる編み物キット。つくりたい気持ちに、ちょうどいい材料を。</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "主按钮",
      "default": "目的から探す"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "主按钮链接"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "次按钮",
      "default": "毛糸を見る"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "次按钮链接"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "毛线品牌主视觉"
    }
  ]
}
{% endschema %}
