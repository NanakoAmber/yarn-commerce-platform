{{ 'yarn-hero-worktable-v2.png' | asset_url | preload_tag: as: 'image' }}

{% liquid
  assign hero_eyebrow = section.settings.eyebrow
  assign hero_heading = section.settings.heading
  assign hero_text = section.settings.text
  assign hero_primary = section.settings.primary_label
  assign hero_secondary = section.settings.secondary_label
  assign trust_title_1 = '作品から始める'
  assign trust_text_1 = '本当に作りたいものを選ぶ'
  assign trust_title_2 = '材料がひとつに'
  assign trust_text_2 = '毛糸・道具・必要量まで迷わない'
  assign trust_title_3 = '手順に沿って完成'
  assign trust_text_3 = '最初の一目から仕上げまで'
  assign continue_label = 'はじめて向けの作品を見る'

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign hero_eyebrow = '让手作回到日常'
      assign hero_heading = '从想做的一件作品，开始一段温柔的手作时间。'
      assign hero_text = '<p>我们把合适的毛线、工具和步骤一起准备好，让第一次动手也不慌张。</p>'
      assign hero_primary = '从作品开始'
      assign hero_secondary = '先看看毛线'
      assign trust_title_1 = '从作品开始'
      assign trust_text_1 = '先选择真正想做的东西'
      assign trust_title_2 = '材料一次配齐'
      assign trust_text_2 = '毛线、工具和用量不再猜'
      assign trust_title_3 = '跟着步骤完成'
      assign trust_text_3 = '从第一针到最后收边'
      assign continue_label = '查看适合第一次做的作品'
    when 'en'
      assign hero_eyebrow = 'Bring making back to everyday life'
      assign hero_heading = 'Begin with something you want to make, and a gentler moment for yourself.'
      assign hero_text = '<p>We bring the right yarn, tools and steps together, so your first project never feels overwhelming.</p>'
      assign hero_primary = 'Start with a project'
      assign hero_secondary = 'Browse yarn first'
      assign trust_title_1 = 'Start with a project'
      assign trust_text_1 = 'Choose something you truly want to make'
      assign trust_title_2 = 'Materials made simple'
      assign trust_text_2 = 'Yarn, tools and quantities in one place'
      assign trust_title_3 = 'Follow it through'
      assign trust_text_3 = 'From the first stitch to the final finish'
      assign continue_label = 'See first-project ideas'
  endcase
%}

<section class="yarn-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="yarn-hero__main">
    <div class="yarn-hero__content page-width">
      {% if hero_eyebrow != blank %}
        <p class="yarn-hero__eyebrow">
          <span class="svg-wrapper" aria-hidden="true">{{- 'icon-plant.svg' | inline_asset_content -}}</span>
          {{ hero_eyebrow | escape }}
        </p>
      {% endif %}

      <h1 class="yarn-hero__heading" lang="{{ request.locale.iso_code }}">{{ hero_heading | escape }}</h1>

      {% if hero_text != blank %}
        <div class="yarn-hero__text rte">{{ hero_text }}</div>
      {% endif %}

      <div class="yarn-hero__actions">
        {% if hero_primary != blank %}
          <a class="button yarn-hero__primary" href="{{ section.settings.primary_link | default: '#shop-by-project' }}">
            {{ hero_primary | escape }}
          </a>
        {% endif %}

        {% if hero_secondary != blank %}
          <a class="yarn-hero__secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">
            {{ hero_secondary | escape }}
            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {% endif %}
      </div>

      <p class="yarn-hero__for-whom">
        {%- case request.locale.iso_code -%}
          {%- when 'zh-CN', 'zh' -%}为第一次做，也为想慢下来的人。
          {%- when 'en' -%}For first projects, and for anyone ready to slow down.
          {%- else -%}はじめての方にも、少し立ち止まりたい方にも。
        {%- endcase -%}
      </p>
    </div>

    <div class="yarn-hero__media">
      <img
        src="{{ 'yarn-hero-worktable-v2.png' | asset_url }}"
        alt=""
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  </div>

  <ul class="yarn-hero__trust page-width" role="list">
    <li>
      <span class="yarn-hero__trust-icon svg-wrapper" aria-hidden="true">{{- 'icon-heart.svg' | inline_asset_content -}}</span>
      <span><strong>{{ trust_title_1 | escape }}</strong><small>{{ trust_text_1 | escape }}</small></span>
    </li>
    <li>
      <span class="yarn-hero__trust-icon svg-wrapper" aria-hidden="true">{{- 'icon-box.svg' | inline_asset_content -}}</span>
      <span><strong>{{ trust_title_2 | escape }}</strong><small>{{ trust_text_2 | escape }}</small></span>
    </li>
    <li>
      <span class="yarn-hero__trust-icon svg-wrapper" aria-hidden="true">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
      <span><strong>{{ trust_title_3 | escape }}</strong><small>{{ trust_text_3 | escape }}</small></span>
    </li>
  </ul>

  <a class="yarn-hero__continue" href="#shop-by-project" aria-label="{{ continue_label | escape }}">
    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
  </a>
</section>

{% stylesheet %}
  .yarn-hero {
    --yarn-hero-ink: #493d31;
    --yarn-hero-paper: #fcfaf5;
    --yarn-hero-sage: #7d9064;
    overflow: hidden;
    border-bottom: 1px solid rgba(73, 61, 49, 0.14);
    background: var(--yarn-hero-paper);
    color: var(--yarn-hero-ink);
  }

  .yarn-hero__main {
    display: grid;
    grid-template-columns: minmax(390px, 42%) minmax(0, 58%);
    height: clamp(405px, 26.5vw, 480px);
    min-height: 405px;
    border-bottom: 1px solid rgba(73, 61, 49, 0.14);
  }

  .yarn-hero__content {
    display: flex;
    width: 100%;
    max-width: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(44px, 5vw, 72px) clamp(28px, 6.5vw, 98px);
  }

  .yarn-hero__eyebrow {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    margin: 0 0 20px;
    color: #596f3f;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .yarn-hero__eyebrow .svg-wrapper {
    width: 18px;
    height: 18px;
  }

  .yarn-hero__heading {
    max-width: 12.4em;
    margin: 0;
    color: var(--yarn-hero-ink);
    font-family: 'Songti SC', 'Hiragino Mincho ProN', 'Yu Mincho', 'Noto Serif CJK SC', Georgia, serif;
    font-size: clamp(3.4rem, 2.4vw, 4.2rem);
    font-weight: 500;
    line-height: 1.34;
    letter-spacing: 0.015em;
  }

  .yarn-hero__text {
    max-width: 43rem;
    margin-top: 18px;
    color: rgba(73, 61, 49, 0.78);
    font-size: clamp(1.4rem, 1.1vw, 1.6rem);
    line-height: 1.85;
  }

  .yarn-hero__text p,
  .yarn-hero__for-whom {
    margin: 0;
  }

  .yarn-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    align-items: center;
    margin-top: 24px;
  }

  .yarn-hero__primary.button {
    min-width: 20.5rem;
    min-height: 5rem;
    border: 1px solid var(--yarn-hero-sage);
    border-radius: 7px;
    background: var(--yarn-hero-sage);
    color: #ffffff;
    box-shadow: none;
  }

  .yarn-hero__primary.button::before,
  .yarn-hero__primary.button::after {
    display: none;
  }

  .yarn-hero__secondary {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 10px 0 7px;
    border-bottom: 1px solid rgba(89, 111, 63, 0.65);
    color: #596f3f;
    font-size: 1.4rem;
    text-decoration: none;
  }

  .yarn-hero__secondary .svg-wrapper {
    width: 16px;
    height: 16px;
  }

  .yarn-hero__for-whom {
    margin-top: 24px;
    color: rgba(73, 61, 49, 0.64);
    font-size: 1.25rem;
  }

  .yarn-hero__media {
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
  }

  .yarn-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .yarn-hero__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 auto;
    padding-top: 17px;
    padding-bottom: 17px;
    list-style: none;
  }

  .yarn-hero__trust li {
    display: flex;
    gap: 15px;
    justify-content: center;
    align-items: center;
    min-width: 0;
    padding: 0 clamp(18px, 3vw, 46px);
  }

  .yarn-hero__trust li + li {
    border-left: 1px solid rgba(73, 61, 49, 0.18);
  }

  .yarn-hero__trust-icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    color: #6f624f;
  }

  .yarn-hero__trust li > span:last-child {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .yarn-hero__trust strong,
  .yarn-hero__trust small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .yarn-hero__trust strong {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .yarn-hero__trust small {
    color: rgba(73, 61, 49, 0.68);
    font-size: 1.15rem;
  }

  .yarn-hero__continue {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .yarn-hero__main {
      display: flex;
      height: auto;
      min-height: 0;
      flex-direction: column;
    }

    .yarn-hero .yarn-hero__content {
      order: 1;
      align-items: stretch;
      padding: 27px 20px 26px;
    }

    .yarn-hero__eyebrow {
      margin-bottom: 16px;
      font-size: 1.2rem;
    }

    .yarn-hero__heading {
      max-width: 12em;
      font-size: clamp(2.7rem, 7.5vw, 3.2rem);
      line-height: 1.34;
    }

    .yarn-hero__text {
      max-width: 33rem;
      margin-top: 14px;
      font-size: 1.35rem;
      line-height: 1.75;
    }

    .yarn-hero__actions {
      display: grid;
      gap: 8px;
      margin-top: 20px;
    }

    .yarn-hero__primary.button {
      width: 100%;
      min-width: 0;
      min-height: 4.8rem;
    }

    .yarn-hero__secondary {
      width: fit-content;
      padding-top: 7px;
      font-size: 1.3rem;
    }

    .yarn-hero__for-whom {
      display: none;
    }

    .yarn-hero__media {
      order: 2;
      width: 100%;
      min-height: 0;
      height: clamp(205px, 56vw, 236px);
    }

    .yarn-hero__media img {
      object-position: 51% center;
    }

    .yarn-hero__trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 17px 8px 15px;
    }

    .yarn-hero__trust li {
      gap: 7px;
      flex-direction: column;
      justify-content: flex-start;
      padding: 0 8px;
      text-align: center;
    }

    .yarn-hero__trust-icon {
      width: 25px;
      min-width: 25px;
      height: 25px;
    }

    .yarn-hero__trust li > span:last-child {
      gap: 2px;
    }

    .yarn-hero__trust strong,
    .yarn-hero__trust small {
      overflow: visible;
      line-height: 1.35;
      text-overflow: clip;
      white-space: normal;
    }

    .yarn-hero__trust strong {
      font-size: 1.1rem;
    }

    .yarn-hero__trust small {
      font-size: 0.92rem;
    }

    .yarn-hero__continue {
      display: grid;
      height: 34px;
      border-top: 1px solid rgba(73, 61, 49, 0.12);
      color: var(--yarn-hero-ink);
      place-items: center;
    }

    .yarn-hero__continue .svg-wrapper {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .yarn-hero__media img {
      animation: yarn-hero-arrive 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .yarn-hero__content > * {
      animation: yarn-copy-arrive 600ms ease-out both;
    }

    .yarn-hero__content > :nth-child(2) { animation-delay: 60ms; }
    .yarn-hero__content > :nth-child(3) { animation-delay: 120ms; }
    .yarn-hero__content > :nth-child(4) { animation-delay: 180ms; }
  }

  @keyframes yarn-hero-arrive {
    from { transform: scale(1.025); opacity: 0.7; }
    to { transform: scale(1); opacity: 1; }
  }

  @keyframes yarn-copy-arrive {
    from { transform: translateY(10px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "毛线品牌主视觉",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "手づくりを、毎日のそばに"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "つくりたい一品から、やさしい手づくりの時間を。"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "说明",
      "default": "<p>ぴったりの毛糸と道具、手順までひとつに。はじめてでも、迷わず始められます。</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "主按钮",
      "default": "作品からはじめる"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "主按钮链接"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "次按钮",
      "default": "まずは毛糸を見る"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "次按钮链接"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "毛线品牌主视觉"
    }
  ]
}
{% endschema %}
