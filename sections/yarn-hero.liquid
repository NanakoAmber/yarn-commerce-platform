{{ 'mewool-hero-project-node-v2.png' | asset_url | preload_tag: as: 'image' }}
{{ 'yarn-hero-b.css' | asset_url | stylesheet_tag }}

{% liquid
  assign hero_heading = section.settings.heading
  assign hero_text = section.settings.text
  assign hero_cta = section.settings.cta_label
  assign flow_project = section.settings.flow_project
  assign flow_yarn = section.settings.flow_yarn
  assign flow_tools = section.settings.flow_tools
  assign flow_tutorial = section.settings.flow_tutorial

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign hero_heading = section.settings.heading_zh
      assign hero_text = section.settings.text_zh
      assign hero_cta = section.settings.cta_label_zh
      assign flow_project = section.settings.flow_project_zh
      assign flow_yarn = section.settings.flow_yarn_zh
      assign flow_tools = section.settings.flow_tools_zh
      assign flow_tutorial = section.settings.flow_tutorial_zh
    when 'en'
      assign hero_heading = section.settings.heading_en
      assign hero_text = section.settings.text_en
      assign hero_cta = section.settings.cta_label_en
      assign flow_project = section.settings.flow_project_en
      assign flow_yarn = section.settings.flow_yarn_en
      assign flow_tools = section.settings.flow_tools_en
      assign flow_tutorial = section.settings.flow_tutorial_en
  endcase
%}

<section class="yarn-hero yarn-hero--connected color-{{ section.settings.color_scheme }}" aria-labelledby="YarnHeroHeading-{{ section.id }}">
  <div class="yarn-hero__visual">
    <div class="yarn-hero__copy">
      <h1 id="YarnHeroHeading-{{ section.id }}" class="yarn-hero__heading" lang="{{ request.locale.iso_code }}">{{ hero_heading | escape | newline_to_br }}</h1>
      {% if hero_text != blank %}<div class="yarn-hero__text rte">{{ hero_text }}</div>{% endif %}
      <a class="button yarn-hero__cta" href="#shop-by-project">{{ hero_cta | escape }}</a>
    </div>

    <ol class="yarn-hero__journey" aria-label="{{ flow_project | escape }} → {{ flow_yarn | escape }} → {{ flow_tools | escape }} → {{ flow_tutorial | escape }}">
      <svg class="yarn-hero__thread yarn-hero__thread--desktop" viewBox="0 0 900 750" preserveAspectRatio="none" aria-hidden="true"><path d="M 530 204 C 595 209 628 153 612 143 C 592 131 590 159 612 163 C 654 173 660 113 700 98 S 864 83 877 140 C 890 190 855 199 853 180 C 851 156 899 175 888 211 C 882 231 862 237 849 264 L 795 370 C 786 412 757 433 745 416 C 731 395 749 381 758 393 C 777 419 795 442 825 445 C 850 452 860 470 866 493 C 884 552 853 564 847 545 C 839 520 882 536 875 565 C 868 604 830 619 779 619"/></svg>
      <svg class="yarn-hero__thread yarn-hero__thread--mobile" viewBox="0 0 354 660" preserveAspectRatio="none" aria-hidden="true"><path d="M 173 346 C 220 320 245 300 252 255 C 261 220 281 230 276 245 C 268 266 246 246 253 218 C 265 174 260 120 290 76 C 341 87 349 163 338 176 C 322 194 315 169 329 167 C 356 163 350 237 335 280 L 318 359 C 329 423 349 428 344 457 C 340 480 319 474 322 461 C 327 440 350 462 342 492 C 337 515 315 542 298 551"/></svg>
      <li class="yarn-hero__node yarn-hero__node--project">
        <a href="#shop-by-project">
          <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-project-node-v2.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager" fetchpriority="high"></span>
          <strong>{{ flow_project | escape }}</strong>
        </a>
      </li>
      <li class="yarn-hero__node yarn-hero__node--yarn">
        <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-yarn-node.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager"></span>
        <strong>{{ flow_yarn | escape }}</strong>
      </li>
      <li class="yarn-hero__node yarn-hero__node--tools">
        <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-tools-node.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager"></span>
        <strong>{{ flow_tools | escape }}</strong>
      </li>
      <li class="yarn-hero__node yarn-hero__node--tutorial">
        <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-tutorial-node.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager"></span>
        <strong>{{ flow_tutorial | escape }}</strong>
      </li>
    </ol>
  </div>
  <svg class="yarn-hero__wave" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><path opacity=".65" d="M0 0C330 0 480 145 900 111S1240 45 1440 54V130H0Z"/><path fill="#fffefa" d="M0 54C350 13 509 161 939 122S1255 83 1440 88V130H0Z"/></svg>
</section>

{% schema %}
{
  "name": "首页 · 毛线串联主视觉",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1" },
    { "type": "textarea", "id": "heading", "label": "日文 · 主标题", "default": "好きな作品から、\n手づくりを始めよう。" },
    { "type": "richtext", "id": "text", "label": "日文 · 说明", "default": "<p>作品に合わせて、毛糸・使用量・道具・作り方をひとつずつ準備できます。</p>" },
    { "type": "text", "id": "cta_label", "label": "日文 · 主操作", "default": "作品を見つける" },
    { "type": "text", "id": "flow_project", "label": "日文 · 步骤一", "default": "作品を選ぶ" },
    { "type": "text", "id": "flow_yarn", "label": "日文 · 步骤二", "default": "毛糸を選ぶ" },
    { "type": "text", "id": "flow_tools", "label": "日文 · 步骤三", "default": "道具をそろえる" },
    { "type": "text", "id": "flow_tutorial", "label": "日文 · 步骤四", "default": "作り方を見る" },
    { "type": "textarea", "id": "heading_zh", "label": "中文 · 主标题", "default": "从喜欢的作品，\n开始你的手作。" },
    { "type": "richtext", "id": "text_zh", "label": "中文 · 说明", "default": "<p>毛线、用量、工具与教程，跟着作品慢慢准备。</p>" },
    { "type": "text", "id": "cta_label_zh", "label": "中文 · 主操作", "default": "发现作品" },
    { "type": "text", "id": "flow_project_zh", "label": "中文 · 步骤一", "default": "选作品" },
    { "type": "text", "id": "flow_yarn_zh", "label": "中文 · 步骤二", "default": "挑毛线" },
    { "type": "text", "id": "flow_tools_zh", "label": "中文 · 步骤三", "default": "找工具" },
    { "type": "text", "id": "flow_tutorial_zh", "label": "中文 · 步骤四", "default": "看教程" },
    { "type": "textarea", "id": "heading_en", "label": "英文 · 主标题", "default": "Start making from\na project you love." },
    { "type": "richtext", "id": "text_en", "label": "英文 · 说明", "default": "<p>Follow the project to prepare your yarn, quantity, tools, and tutorial one step at a time.</p>" },
    { "type": "text", "id": "cta_label_en", "label": "英文 · 主操作", "default": "Discover projects" },
    { "type": "text", "id": "flow_project_en", "label": "英文 · 步骤一", "default": "Choose a project" },
    { "type": "text", "id": "flow_yarn_en", "label": "英文 · 步骤二", "default": "Pick yarn" },
    { "type": "text", "id": "flow_tools_en", "label": "英文 · 步骤三", "default": "Find tools" },
    { "type": "text", "id": "flow_tutorial_en", "label": "英文 · 步骤四", "default": "View tutorial" }
  ],
  "presets": [{ "name": "首页 · 毛线串联主视觉" }]
}
{% endschema %}
