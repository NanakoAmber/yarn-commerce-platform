{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count
  assign discovery_search_label = '作品や毛糸を検索'
  assign discovery_search_placeholder = 'つくりたい作品や毛糸を検索'
  assign filter_type = '作品タイプ'
  assign filter_difficulty = '難易度'
  assign filter_time = '完成時間'
  assign filter_method = '編み方'
  assign filter_scene = '用途'
  assign option_bag = 'バッグ'
  assign option_shawl = 'ショール'
  assign option_blanket = 'ブランケット'
  assign option_beginner = 'はじめて向け'
  assign option_one_ball = '1玉で完成'
  assign option_weekend = '週末に完成'
  assign option_slow = 'ゆっくり作る'
  assign option_crochet = 'かぎ針'
  assign option_knit = '棒針'
  assign option_myself = '自分用'
  assign option_gift = '贈りもの'

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign discovery_search_label = '搜索作品或毛线'
      assign discovery_search_placeholder = '搜索想做的作品或毛线'
      assign filter_type = '作品类型'
      assign filter_difficulty = '难度'
      assign filter_time = '完成时间'
      assign filter_method = '编织方式'
      assign filter_scene = '使用场景'
      assign option_bag = '包袋'
      assign option_shawl = '披肩'
      assign option_blanket = '毯子'
      assign option_beginner = '第一次制作'
      assign option_one_ball = '一团完成'
      assign option_weekend = '周末完成'
      assign option_slow = '慢慢制作'
      assign option_crochet = '钩针'
      assign option_knit = '棒针'
      assign option_myself = '自己使用'
      assign option_gift = '亲手送礼'
    when 'en'
      assign discovery_search_label = 'Search projects or yarn'
      assign discovery_search_placeholder = 'Search for a project or yarn'
      assign filter_type = 'Project type'
      assign filter_difficulty = 'Difficulty'
      assign filter_time = 'Time to finish'
      assign filter_method = 'Method'
      assign filter_scene = 'For'
      assign option_bag = 'Bags'
      assign option_shawl = 'Shawls'
      assign option_blanket = 'Blankets'
      assign option_beginner = 'First project'
      assign option_one_ball = 'One-ball project'
      assign option_weekend = 'Finish in a weekend'
      assign option_slow = 'Take your time'
      assign option_crochet = 'Crochet'
      assign option_knit = 'Knitting'
      assign option_myself = 'For myself'
      assign option_gift = 'Make a gift'
  endcase

  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign max_columns_to_show = columns_mobile_int
  if columns_desktop_int > columns_mobile_int
    assign max_columns_to_show = columns_desktop_int
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif
-%}

<div
  class="color-{{ section.settings.color_scheme }} isolate gradient"
>
  <div
    class="collection{% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}{% if section.settings.show_discovery_tools %} yarn-discovery-collection{% endif %} section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% endif %}{% if show_desktop_slider %} collection__title--desktop-slider{% endif %}">
      {%- if section.settings.title != blank -%}
        {%- liquid
          assign featured_title = section.settings.title
          if section.settings.title == '人気の毛糸とキット'
            case request.locale.iso_code
              when 'zh-CN', 'zh'
                assign featured_title = '人气毛线与编织套装'
              when 'en'
                assign featured_title = 'Popular yarns and kits'
            endcase
          elsif section.settings.title == '作品と材料を見つける'
            case request.locale.iso_code
              when 'zh-CN', 'zh'
                assign featured_title = '发现作品与材料'
              when 'en'
                assign featured_title = 'Discover projects and materials'
            endcase
          endif
        -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ featured_title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank
        or section.settings.show_description
        and section.settings.collection.description != empty
      -%}
        <div class="collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.show_description -%}
            {{ section.settings.collection.description }}
          {%- else -%}
            {{ section.settings.description -}}
          {%- endif %}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_discovery_tools -%}
      <div class="yarn-discovery page-width">
        <form class="yarn-discovery__search" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="YarnDiscoverySearch-{{ section.id }}">{{ discovery_search_label | escape }}</label>
          <span class="svg-wrapper" aria-hidden="true">{{- 'icon-search.svg' | inline_asset_content -}}</span>
          <input
            id="YarnDiscoverySearch-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ discovery_search_placeholder | escape }}"
            autocomplete="off"
          >
          <input type="hidden" name="type" value="product">
          <button type="submit">
            <span>{{ discovery_search_label | escape }}</span>
            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </button>
        </form>

        <div class="yarn-discovery__filters" aria-label="{{ filter_type | escape }}">
          <form action="{{ routes.search_url }}" method="get">
            <label class="visually-hidden" for="YarnFilterType-{{ section.id }}">{{ filter_type | escape }}</label>
            <select id="YarnFilterType-{{ section.id }}" name="q" onchange="if (this.value) this.form.submit()">
              <option value="" selected disabled>{{ filter_type | escape }}</option>
              <option value="バッグ">{{ option_bag | escape }}</option>
              <option value="ショール">{{ option_shawl | escape }}</option>
              <option value="ブランケット">{{ option_blanket | escape }}</option>
            </select>
            <input type="hidden" name="type" value="product">
            <button class="visually-hidden" type="submit">{{ filter_type | escape }}</button>
          </form>

          <form action="{{ routes.search_url }}" method="get">
            <label class="visually-hidden" for="YarnFilterDifficulty-{{ section.id }}">{{ filter_difficulty | escape }}</label>
            <select id="YarnFilterDifficulty-{{ section.id }}" name="q" onchange="if (this.value) this.form.submit()">
              <option value="" selected disabled>{{ filter_difficulty | escape }}</option>
              <option value="tag:編みものキット">{{ option_beginner | escape }}</option>
              <option value="1玉">{{ option_one_ball | escape }}</option>
            </select>
            <input type="hidden" name="type" value="product">
            <button class="visually-hidden" type="submit">{{ filter_difficulty | escape }}</button>
          </form>

          <form action="{{ routes.search_url }}" method="get">
            <label class="visually-hidden" for="YarnFilterTime-{{ section.id }}">{{ filter_time | escape }}</label>
            <select id="YarnFilterTime-{{ section.id }}" name="q" onchange="if (this.value) this.form.submit()">
              <option value="" selected disabled>{{ filter_time | escape }}</option>
              <option value="バッグ">{{ option_weekend | escape }}</option>
              <option value="ブランケット">{{ option_slow | escape }}</option>
            </select>
            <input type="hidden" name="type" value="product">
            <button class="visually-hidden" type="submit">{{ filter_time | escape }}</button>
          </form>

          <form action="{{ routes.search_url }}" method="get">
            <label class="visually-hidden" for="YarnFilterMethod-{{ section.id }}">{{ filter_method | escape }}</label>
            <select id="YarnFilterMethod-{{ section.id }}" name="q" onchange="if (this.value) this.form.submit()">
              <option value="" selected disabled>{{ filter_method | escape }}</option>
              <option value="かぎ針">{{ option_crochet | escape }}</option>
              <option value="編み物">{{ option_knit | escape }}</option>
            </select>
            <input type="hidden" name="type" value="product">
            <button class="visually-hidden" type="submit">{{ filter_method | escape }}</button>
          </form>

          <form action="{{ routes.search_url }}" method="get">
            <label class="visually-hidden" for="YarnFilterScene-{{ section.id }}">{{ filter_scene | escape }}</label>
            <select id="YarnFilterScene-{{ section.id }}" name="q" onchange="if (this.value) this.form.submit()">
              <option value="" selected disabled>{{ filter_scene | escape }}</option>
              <option value="tag:編みものキット">{{ option_myself | escape }}</option>
              <option value="tag:ギフトセット OR tag:完成品">{{ option_gift | escape }}</option>
            </select>
            <input type="hidden" name="type" value="product">
            <button class="visually-hidden" type="submit">{{ filter_scene | escape }}</button>
          </form>
        </div>
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if show_mobile_slider == false %} page-width{% endif %}{% if show_desktop_slider == false and section.settings.full_width == false %} page-width-desktop{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop{% if section.settings.collection == blank %} grid--2-col-tablet-down{% else %} grid--{{ section.settings.columns_mobile }}-col-tablet-down{% endif %}{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {% assign skip_card_product_styles = false %}

        {%- if section.settings.collection.products.size > 0 -%}
          {% assign lazy_load = false %}
          {% paginate section.settings.collection.products by section.settings.products_to_show %}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              {% if lazy_load == false and forloop.index > max_columns_to_show %}
                {% assign lazy_load = true %}
              {% endif %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  lazy_load: lazy_load,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  product_view_context: 'collection'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {% endpaginate %}
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% liquid
                assign ridx = forloop.rindex
                case ridx
                  when 5
                    assign ridx = 1
                  when 6
                    assign ridx = 2
                endcase
              %}
              {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
              {% render 'card-product',
                show_vendor: section.settings.show_vendor,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                lazy_load: false,
                placeholder_image: placeholder_image
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ products_to_display }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and more_in_collection -%}
      <div class="center collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <a
          href="{{ section.settings.collection.url }}"
          class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title | escape }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .yarn-discovery-collection {
    background: #fffdf9;
  }

  .yarn-discovery-collection .collection__title {
    margin-bottom: 14px;
  }

  .yarn-discovery-collection .collection__title .title {
    color: #493d31;
    font-family: 'Songti SC', 'Hiragino Mincho ProN', 'Yu Mincho', 'Noto Serif CJK SC', Georgia, serif;
    font-size: clamp(2.4rem, 2.4vw, 3.4rem);
    letter-spacing: 0.01em;
  }

  .yarn-discovery {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto;
    gap: 24px;
    align-items: center;
    margin-bottom: 28px;
  }

  .yarn-discovery__search {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    border-radius: 999px;
    background: #f4f0e9;
  }

  .yarn-discovery__search > .svg-wrapper {
    position: absolute;
    left: 17px;
    width: 18px;
    height: 18px;
    color: #493d31;
    pointer-events: none;
  }

  .yarn-discovery__search input {
    width: 100%;
    height: 46px;
    padding: 0 124px 0 47px;
    border: 1px solid transparent;
    border-radius: 999px;
    outline: none;
    background: transparent;
    color: #493d31;
    font: inherit;
    font-size: 1.3rem;
  }

  .yarn-discovery__search input:focus-visible {
    border-color: #7d9064;
    box-shadow: 0 0 0 2px rgba(125, 144, 100, 0.2);
  }

  .yarn-discovery__search button {
    position: absolute;
    right: 5px;
    min-width: 104px;
    height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: #7d9064;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 1.15rem;
  }

  .yarn-discovery__search button .svg-wrapper {
    display: none;
  }

  .yarn-discovery__filters {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    align-items: center;
  }

  .yarn-discovery__filters form {
    flex: 0 0 auto;
  }

  .yarn-discovery__filters select {
    min-height: 42px;
    padding: 0 34px 0 15px;
    border: 1px solid rgba(73, 61, 49, 0.2);
    border-radius: 999px;
    background-color: #fffdf9;
    color: #493d31;
    cursor: pointer;
    font: inherit;
    font-size: 1.2rem;
  }

  .yarn-discovery-collection .product-grid {
    row-gap: 30px;
  }

  @media screen and (max-width: 989px) {
    .yarn-discovery {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .yarn-discovery__filters {
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .yarn-discovery__filters::-webkit-scrollbar {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .yarn-discovery-collection .collection__title {
      margin-bottom: 10px;
    }

    .yarn-discovery-collection .collection__title .title {
      font-size: 2rem;
    }

    .yarn-discovery {
      margin-bottom: 20px;
    }

    .yarn-discovery__search input {
      height: 44px;
      padding-right: 48px;
    }

    .yarn-discovery__search button {
      right: 4px;
      width: 36px;
      min-width: 36px;
      height: 36px;
      padding: 0;
    }

    .yarn-discovery__search button > span:first-child {
      display: none;
    }

    .yarn-discovery__search button .svg-wrapper {
      display: grid;
      width: 16px;
      height: 16px;
      margin: auto;
      place-items: center;
    }

    .yarn-discovery__filters select {
      min-height: 38px;
      font-size: 1.1rem;
    }

    .yarn-discovery-collection .product-grid {
      row-gap: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "checkbox",
      "id": "show_discovery_tools",
      "label": "显示作品搜索与筛选",
      "default": false
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-collection.settings.show_description.label",
      "default": false
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_collection.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
        {
