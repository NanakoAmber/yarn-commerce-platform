{%- comment -%}
  Editorial copy/media come from Shopify. Inspiration is not a verified Project.
  Internal mode is not authentication: keep the shop password enabled.
{%- endcomment -%}
{%- liquid
  assign inspirations = section.settings.inspirations
  if section.settings.use_featured
    assign inspirations = shop.metaobjects.inspiration.values
  endif
  assign shown_count = 0
-%}
{%- capture cards -%}
  {%- for inspiration in inspirations -%}
    {%- liquid
      assign show_entry = false
      assign release_scope = inspiration.publish_scope.value
      if release_scope == '可正式发布' or release_scope == '可公开演示'
        assign show_entry = true
      elsif release_scope == '仅内部原型' and section.settings.show_internal
        assign show_entry = true
      endif
      if section.settings.use_featured and inspiration.featured.value != true
        assign show_entry = false
      endif
      if inspiration.title.value == blank or inspiration.cover_image.value == blank
        assign show_entry = false
      endif
    -%}
    {%- if show_entry -%}
      {%- assign shown_count = shown_count | plus: 1 -%}
      <article class="yarn-inspiration__card" data-inspiration="{{ inspiration.system.handle | escape }}">
        {{ inspiration.cover_image.value | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 45vw, 100vw', alt: inspiration.title.value, class: 'yarn-inspiration__image' }}
        <div class="yarn-inspiration__copy">
          <h3>{{ inspiration.title.value | escape }}</h3>
          {%- if inspiration.summary.value != blank -%}
            <p>{{ inspiration.summary.value | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if inspiration.difficulty.value != blank or inspiration.estimated_time.value != blank -%}
            <p class="yarn-inspiration__meta">{{ inspiration.difficulty.value | escape }}{% if inspiration.difficulty.value != blank and inspiration.estimated_time.value != blank %} · {% endif %}{{ inspiration.estimated_time.value | escape }}</p>
          {%- endif -%}
          {%- if inspiration.gallery.value != blank -%}
            <details class="yarn-inspiration__details">
              <summary>{{ 'yarn_content.gallery' | t }}</summary>
              <div class="yarn-inspiration__gallery">
                {%- for media in inspiration.gallery.value limit: 6 -%}
                  {{ media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 800', sizes: '(min-width: 750px) 22vw, 45vw', alt: inspiration.title.value }}
                {%- endfor -%}
              </div>
            </details>
          {%- endif -%}
          {%- if inspiration.recommended_products.value != blank -%}
            <p class="yarn-inspiration__label">{{ 'yarn_content.products' | t }}</p>
            <ul class="yarn-inspiration__products" role="list">
              {%- for related_product in inspiration.recommended_products.value -%}
                {%- if related_product.url != blank -%}
                  <li><a href="{{ related_product.url }}">
                    <span>{{ related_product.title | escape }}</span>
                    <span>{% if related_product.price_varies %}{{ 'yarn_content.from' | t }} {% endif %}{{ related_product.price | money }}{% unless related_product.available %} · {{ 'products.product.sold_out' | t }}{% endunless %} →</span>
                  </a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if release_scope == '仅内部原型' -%}
            <p class="yarn-inspiration__notice">{{ 'yarn_content.internal' | t }}</p>
          {%- endif -%}
        </div>
      </article>
      {%- if shown_count == 12 -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if cards != blank -%}
  <section class="yarn-inspiration color-{{ section.settings.color_scheme }} gradient" aria-labelledby="InspirationTitle-{{ section.id }}">
    <div class="page-width">
      <header class="yarn-inspiration__header">
        <h2 id="InspirationTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </header>
      <div class="yarn-inspiration__grid">{{ cards }}</div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width yarn-inspiration__empty">{{ 'yarn_content.empty' | t }}</div>
{%- endif -%}

{% stylesheet %}
  .yarn-inspiration { padding: 4.8rem 0; }
  .yarn-inspiration__header { max-width: 72rem; margin-bottom: 3.2rem; }
  .yarn-inspiration__header h2 { margin: 0 0 1.6rem; }
  .yarn-inspiration__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem 3.2rem; }
  .yarn-inspiration__card { min-width: 0; }
  .yarn-inspiration__image { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .yarn-inspiration__copy { padding-top: 2rem; overflow-wrap: anywhere; }
  .yarn-inspiration__copy h3 { font-size: 2.4rem; margin: 0 0 1.2rem; line-height: 1.4; }
  .yarn-inspiration__copy p { margin: 0 0 1.6rem; line-height: 1.8; }
  .yarn-inspiration__meta, .yarn-inspiration__notice { font-size: 1.3rem; }
  .yarn-inspiration__label { font-weight: 600; }
  .yarn-inspiration__products { list-style: none; padding: 0; margin: 0 0 1.6rem; }
  .yarn-inspiration__products a { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem 2rem; min-height: 4.4rem; padding: 1.2rem 0; color: inherit; text-underline-offset: 0.3rem; border-top: 0.1rem solid rgba(var(--color-foreground), 0.2); }
  .yarn-inspiration__products a span:last-child { flex-shrink: 0; }
  .yarn-inspiration__details { margin-bottom: 2rem; }
  .yarn-inspiration__details summary { display: list-item; min-height: 4.4rem; padding: 1rem 0; cursor: pointer; }
  .yarn-inspiration__gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .yarn-inspiration__gallery img { width: 100%; height: auto; }
  .yarn-inspiration__empty { padding-top: 4rem; padding-bottom: 4rem; }
  @media screen and (max-width: 749px) {
    .yarn-inspiration { padding: 3.2rem 0; }
    .yarn-inspiration__grid { grid-template-columns: minmax(0, 1fr); gap: 3.2rem; }
    .yarn-inspiration__copy h3 { font-size: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "灵感作品（后台内容）",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "给下一件手作，一点灵感" },
    { "type": "richtext", "id": "text", "label": "简介", "default": "<p>从喜欢的色彩和作品出发，再看看相关商品。</p>" },
    { "type": "checkbox", "id": "use_featured", "label": "自动展示勾选了首页推荐的作品", "default": true, "info": "读取前 12 条有效作品。如需自定义顺序，关闭后使用下方作品列表。" },
    { "type": "metaobject_list", "id": "inspirations", "label": "作品与顺序", "metaobject_type": "inspiration", "limit": 12 },
    { "type": "checkbox", "id": "show_internal", "label": "包含内部原型素材", "default": false, "info": "仅限密码保护的内部预览。不是访问控制；对外演示或发布前必须关闭，并核对素材授权。" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1" }
  ],
  "presets": [{ "name": "灵感作品（后台内容）" }]
}
{% endschema %}
