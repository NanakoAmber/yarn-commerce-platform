{% liquid
  assign purpose_heading = section.settings.heading
  assign bag_label = section.settings.bag_label
  assign scarf_label = section.settings.scarf_label
  assign blanket_label = section.settings.blanket_label
  assign doll_label = section.settings.doll_label
  assign popular_label = section.settings.popular_label
  assign one_ball_label = section.settings.one_ball_label
  assign gift_label = section.settings.gift_label
  assign season_label = section.settings.season_label
  assign cta_label = section.settings.cta_label
  assign starter_label = section.settings.starter_label
  assign kit_default_link = routes.root_url | append: '?discover_type=kit#discover-products'
  assign kit_link = section.settings.popular_link
  assign browse_link = section.settings.cta_link

  comment
    Existing theme settings may retain the former all-products anchor.
    Migrate that exact legacy destination without replacing custom links.
  endcomment
  if kit_link == blank or kit_link == '#discover-products'
    assign kit_link = kit_default_link
  endif
  if browse_link == blank or browse_link == '#discover-products'
    assign browse_link = kit_default_link
  endif

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign purpose_heading = section.settings.purpose_heading_zh
      assign bag_label = section.settings.bag_label_zh
      assign scarf_label = section.settings.scarf_label_zh
      assign blanket_label = section.settings.blanket_label_zh
      assign doll_label = section.settings.doll_label_zh
      assign popular_label = section.settings.popular_label_zh
      assign one_ball_label = section.settings.one_ball_label_zh
      assign gift_label = section.settings.gift_label_zh
      assign season_label = section.settings.season_label_zh
      assign cta_label = section.settings.cta_label_zh
      assign starter_label = section.settings.label_zh
    when 'en'
      assign purpose_heading = section.settings.purpose_heading_en
      assign bag_label = section.settings.bag_label_en
      assign scarf_label = section.settings.scarf_label_en
      assign blanket_label = section.settings.blanket_label_en
      assign doll_label = section.settings.doll_label_en
      assign popular_label = section.settings.popular_label_en
      assign one_ball_label = section.settings.one_ball_label_en
      assign gift_label = section.settings.gift_label_en
      assign season_label = section.settings.season_label_en
      assign cta_label = section.settings.cta_label_en
      assign starter_label = section.settings.label_en
  endcase
%}

<section id="shop-by-project" class="yarn-purpose color-{{ section.settings.color_scheme }} gradient" aria-labelledby="YarnPurposeHeading-{{ section.id }}">
  <div class="yarn-purpose__atlas">
    <header class="yarn-purpose__heading-wrap">
      <img src="{{ 'impeccable-category-heading-flourish.png' | asset_url }}" alt="" width="1706" height="368" loading="eager">
      <h2 id="YarnPurposeHeading-{{ section.id }}" class="yarn-purpose__title">{{ purpose_heading | escape }}</h2>
    </header>

    <nav class="yarn-purpose__categories" aria-label="{{ purpose_heading | escape }}">
      <a class="yarn-purpose__category yarn-purpose__category--bag" href="{{ section.settings.bag_link | default: '?discover_project=bag#discover-products' }}">
        <img src="{{ 'impeccable-category-bag-plate.png' | asset_url }}" alt="" width="1479" height="1064" loading="eager">
        <span>{{ bag_label | escape }}</span>
      </a>
      <a class="yarn-purpose__category yarn-purpose__category--scarf" href="{{ section.settings.scarf_link | default: '?discover_project=shawl#discover-products' }}">
        <img src="{{ 'impeccable-category-scarf-plate.png' | asset_url }}" alt="" width="1479" height="1064" loading="eager">
        <span>{{ scarf_label | escape }}</span>
      </a>
      <a class="yarn-purpose__category yarn-purpose__category--blanket" href="{{ section.settings.blanket_link | default: '?discover_project=blanket#discover-products' }}">
        <img src="{{ 'impeccable-category-blanket-plate.png' | asset_url }}" alt="" width="1479" height="1064" loading="eager">
        <span>{{ blanket_label | escape }}</span>
      </a>
      <a class="yarn-purpose__category yarn-purpose__category--doll" href="{{ section.settings.doll_link | default: '?discover_project=toy#discover-products' }}">
        <img src="{{ 'impeccable-category-doll-plate.png' | asset_url }}" alt="" width="1479" height="1064" loading="eager">
        <span>{{ doll_label | escape }}</span>
      </a>
    </nav>

    <nav class="yarn-purpose__filters" aria-label="{{ purpose_heading | escape }}">
      <a href="{{ kit_link | escape }}">
        <svg aria-hidden="true" viewBox="0 0 32 32"><path d="M18 3c1 6-5 7-2 13 1-4 5-5 6-9 4 4 6 8 6 12a12 12 0 0 1-24 0c0-5 3-9 8-13 0 5 2 7 4 8"/></svg>
        <span>{{ popular_label | escape }}</span>
      </a>
      <a href="{{ section.settings.one_ball_link | default: '?discover_quantity=one-ball#discover-products' }}">
        <svg aria-hidden="true" viewBox="0 0 32 32"><circle cx="14" cy="14" r="9"/><path d="M7 8c5 4 10 7 16 8M7 20c5-4 9-9 12-15M5 14c6 0 12 3 16 8m2 1c3 0 5 2 5 5"/></svg>
        <span>{{ one_ball_label | escape }}</span>
      </a>
      <a href="{{ section.settings.gift_link | default: '?discover_project=gift#discover-products' }}">
        <svg aria-hidden="true" viewBox="0 0 32 32"><path d="M4 13h24v15H4zM2 8h28v6H2zM16 8v20M10 8c-4 0-5-6-1-6 3 0 5 4 7 6m6 0c4 0 5-6 1-6-3 0-5 4-7 6"/></svg>
        <span>{{ gift_label | escape }}</span>
      </a>
      <a href="{{ section.settings.season_link | default: '?discover_season=cold#discover-products' }}">
        <svg aria-hidden="true" viewBox="0 0 32 32"><path d="M16 2v28M4 9l24 14M4 23 28 9M11 5l5 5 5-5M11 27l5-5 5 5M4 14l7-2-2-7m19 13-7 2 2 7M9 27l2-7-7-2m19-13-2 7 7 2"/></svg>
        <span>{{ season_label | escape }}</span>
      </a>
    </nav>

    <a class="yarn-purpose__cta" href="{{ browse_link | escape }}">
      <span>{{ cta_label | escape }}</span><span aria-hidden="true">→</span>
    </a>
  </div>

  <a class="yarn-purpose__starter-cue" href="{{ section.settings.starter_link | default: '?discover_quantity=one-ball#discover-products' }}">
    <img src="{{ 'impeccable-next-section-flourish.png' | asset_url }}" alt="" width="1706" height="368" loading="lazy">
    <span>{{ starter_label | escape }}</span>
  </a>
</section>

{% stylesheet %}
  .section:has(.yarn-purpose) { margin-top: 0 !important; }

  .yarn-purpose.yarn-purpose {
    padding: clamp(62px, 6.5vw, 94px) 0 0;
    background: #f7f7f5;
    color: #2f302f;
  }

  .yarn-purpose__atlas {
    width: min(calc(100% - 96px), 1220px);
    margin: 0 auto;
    padding: clamp(28px, 3vw, 46px) clamp(18px, 2.3vw, 34px) clamp(30px, 3.2vw, 48px);
    border: 1px solid rgba(177, 166, 149, 0.2);
    border-radius: 24px;
    background: rgba(255, 255, 254, 0.96);
    box-shadow: 0 18px 50px rgba(127, 103, 82, 0.09);
  }

  .yarn-purpose__heading-wrap {
    position: relative;
    display: grid;
    min-height: clamp(102px, 11vw, 150px);
    place-items: center;
  }

  .yarn-purpose__heading-wrap > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .yarn-purpose__title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #2d2f2d;
    font-family: var(--yarn-display);
    font-size: clamp(3.4rem, 3.8vw, 5.6rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.025em;
  }

  .yarn-purpose__categories {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .yarn-purpose__category {
    display: flex;
    min-width: 0;
    aspect-ratio: 0.78;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(10px, 1.5vw, 20px) clamp(8px, 1vw, 14px) clamp(18px, 2vw, 28px);
    border-radius: 16px;
    color: #242625;
    text-decoration: none;
    transition: transform 260ms cubic-bezier(.16,1,.3,1), box-shadow 260ms cubic-bezier(.16,1,.3,1);
  }

  .yarn-purpose__category--bag { background: #faecea; }
  .yarn-purpose__category--scarf { background: #edf5f7; }
  .yarn-purpose__category--blanket { background: #edf4ee; }
  .yarn-purpose__category--doll { background: #fff6df; }

  .yarn-purpose__category img {
    width: 100%;
    height: 72%;
    object-fit: contain;
    transform: scale(1.22);
  }

  .yarn-purpose__category--bag img { transform: scale(1.55); }
  .yarn-purpose__category--scarf img { transform: scale(1.55); }
  .yarn-purpose__category--blanket img { transform: scale(1.65); }
  .yarn-purpose__category--doll img { transform: scale(1.72); }

  .yarn-purpose__category span {
    font-size: clamp(1.8rem, 2vw, 2.8rem);
    line-height: 1.3;
    text-align: center;
    transform: translateY(-12px);
  }

  .yarn-purpose__category:hover,
  .yarn-purpose__category:focus-visible {
    z-index: 1;
    box-shadow: 0 15px 34px rgba(99, 82, 66, 0.12);
    transform: translateY(-5px);
  }

  .yarn-purpose__filters {
    display: grid;
    min-height: clamp(82px, 8.5vw, 118px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(28px, 3vw, 42px);
    border: 1px solid #e5e0d8;
    border-radius: 14px;
    background: #fffefa;
  }

  .yarn-purpose__filters a {
    display: flex;
    min-width: 0;
    gap: 5px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px;
    color: #2b2d2b;
    font-size: clamp(1.45rem, 1.65vw, 2.2rem);
    text-decoration: none;
  }

  .yarn-purpose__filters a + a { border-left: 1px solid #e8e2da; }
  .yarn-purpose__filters svg { width: clamp(24px, 2.6vw, 36px); fill: none; stroke: currentcolor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.45; }
  .yarn-purpose__filters a:hover span { text-decoration: underline; text-decoration-color: #e89487; text-underline-offset: 0.45em; }

  .yarn-purpose__cta {
    display: grid;
    min-height: clamp(72px, 7.8vw, 104px);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: clamp(28px, 3vw, 42px);
    padding: 16px clamp(24px, 3.5vw, 52px);
    border-radius: 15px;
    background: #f8e5a9;
    color: #2c2e2c;
    font-size: clamp(1.8rem, 2vw, 2.8rem);
    text-decoration: none;
    transition: background-color 180ms ease, transform 260ms cubic-bezier(.16,1,.3,1);
  }

  .yarn-purpose__cta span:first-child { grid-column: 2; }
  .yarn-purpose__cta span:last-child { justify-self: end; color: #e58b7d; font-size: 1.75em; line-height: 1; }
  .yarn-purpose__cta:hover { background: #f5dda0; transform: translateY(-2px); }

  .yarn-purpose__starter-cue {
    position: relative;
    display: grid;
    width: min(calc(100% - 96px), 1220px);
    min-height: clamp(150px, 16vw, 220px);
    margin: clamp(30px, 3vw, 42px) auto 0;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(177, 166, 149, 0.16);
    border-bottom: 0;
    border-radius: 24px 24px 0 0;
    background: #fffefa;
    color: #2e302e;
    text-decoration: none;
  }

  .yarn-purpose__starter-cue img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0.82; }
  .yarn-purpose__starter-cue span { position: relative; z-index: 1; padding: 0 14%; font-size: clamp(2rem, 2.5vw, 3.4rem); line-height: 1.35; text-align: center; transform: translateY(-12px); }

  @media screen and (max-width: 989px) {
    .yarn-purpose { padding-top: clamp(50px, 6.8vw, 58px); }
    .yarn-purpose__atlas { width: calc(100% - clamp(36px, 10.8vw, 92px)); padding: clamp(24px, 3.2vw, 30px) clamp(14px, 1.9vw, 18px) clamp(26px, 3.5vw, 34px); border-radius: clamp(16px, 2.8vw, 24px); }
    .yarn-purpose__heading-wrap { min-height: clamp(100px, 16vw, 136px); }
    .yarn-purpose__title { font-size: clamp(3rem, 5.2vw, 4.4rem); }
    .yarn-purpose__categories { gap: clamp(10px, 2.4vw, 20px); }
    .yarn-purpose__category { aspect-ratio: 0.55; border-radius: clamp(10px, 1.8vw, 15px); }
    .yarn-purpose__category span { font-size: clamp(1.45rem, 3.4vw, 2.9rem); }
    .yarn-purpose__filters { min-height: clamp(78px, 13.8vw, 118px); margin-top: clamp(24px, 4.2vw, 36px); }
    .yarn-purpose__filters a { gap: clamp(6px, 1.4vw, 12px); padding: 10px 6px; font-size: clamp(1.2rem, 2.8vw, 2.4rem); }
    .yarn-purpose__filters svg { width: clamp(22px, 4.7vw, 40px); }
    .yarn-purpose__cta { min-height: clamp(64px, 11.5vw, 98px); margin-top: clamp(24px, 4vw, 34px); font-size: clamp(1.5rem, 3.2vw, 2.7rem); }
    .yarn-purpose__starter-cue { width: calc(100% - clamp(36px, 10.8vw, 92px)); min-height: clamp(118px, 16vw, 140px); margin-top: clamp(24px, 3.2vw, 30px); }
    .yarn-purpose__starter-cue span { color: #202120; font-size: clamp(2rem, 3.6vw, 3.2rem); font-weight: 500; letter-spacing: 0.12em; }
  }

  @media screen and (max-width: 599px) {
    .yarn-purpose { padding-top: 42px; }
    .yarn-purpose__atlas { width: calc(100% - 28px); padding: 22px 12px 24px; }
    .yarn-purpose__heading-wrap { min-height: 82px; }
    .yarn-purpose__title { font-size: 3rem; }
    .yarn-purpose__categories { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .yarn-purpose__category { aspect-ratio: 0.86; }
    .yarn-purpose__category img { height: 76%; transform: scale(1.08); }
    .yarn-purpose__category span { font-size: 1.55rem; }
    .yarn-purpose__category span { transform: none; }
    .yarn-purpose__filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .yarn-purpose__filters a { min-height: 62px; font-size: 1.3rem; }
    .yarn-purpose__filters a:nth-child(3) { border-left: 0; border-top: 1px solid #e8e2da; }
    .yarn-purpose__filters a:nth-child(4) { border-top: 1px solid #e8e2da; }
    .yarn-purpose__cta { min-height: 66px; padding: 12px 18px; font-size: 1.55rem; }
    .yarn-purpose__starter-cue { width: calc(100% - 28px); min-height: 112px; }
    .yarn-purpose__starter-cue span { padding: 0 12%; font-size: 1.75rem; }
  }
{% endstylesheet %}

