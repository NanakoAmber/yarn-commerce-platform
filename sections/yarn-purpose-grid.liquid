{% liquid
  assign purpose_heading = section.settings.heading
  assign purpose_text = section.settings.text
  assign view_all_label = 'すべての作品'
  assign card_level = 'はじめて向け'
  assign kit_label = '材料キットあり'

  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign purpose_heading = '适合第一次做的作品'
      assign purpose_text = '<p>从两三个小时的小作品开始，先完成一次，再慢慢喜欢上手作。</p>'
      assign view_all_label = '全部作品'
      assign card_level = '入门'
      assign kit_label = '有材料包'
    when 'en'
      assign purpose_heading = 'A gentle first project'
      assign purpose_text = '<p>Begin with a small project, finish something once, and find your own rhythm from there.</p>'
      assign view_all_label = 'All projects'
      assign card_level = 'Beginner'
      assign kit_label = 'Kit available'
  endcase
%}

<section id="shop-by-project" class="yarn-purpose color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="yarn-purpose__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="yarn-purpose__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 class="yarn-purpose__title">{{ purpose_heading | escape }}</h2>
        {% if purpose_text != blank %}
          <div class="yarn-purpose__intro rte">{{ purpose_text }}</div>
        {% endif %}
      </div>
      <a class="yarn-purpose__view-all" href="{{ routes.all_products_collection_url }}">
        {{ view_all_label | escape }}
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
      </a>
    </div>

    <div class="yarn-purpose__scroller">
      <div class="yarn-purpose__grid">
        {% for block in section.blocks %}
          {% liquid
            assign purpose_handle = 'mousse-bag-crochet-kit'
            assign project_title = 'Mousse Bag'
            assign project_time = '3–5時間'
            case forloop.index
              when 2
                assign purpose_handle = 'ami-uchiwa-lace-kit'
                assign project_title = 'レースの編みうちわ'
                assign project_time = '2–3時間'
              when 3
                assign purpose_handle = 'joyful-hanabi-shawl-crochet-kit'
                assign project_title = '花火ショール'
                assign project_time = '4–6時間'
              when 4
                assign purpose_handle = 'melody-wave-blanket-crochet-kit'
                assign project_title = '波模様ブランケット'
                assign project_time = '8–12時間'
              when 5
                assign purpose_handle = 'tutu-bag-kit'
                assign project_title = 'Tutu Bag'
                assign project_time = '5–7時間'
            endcase

            case request.locale.iso_code
              when 'zh-CN', 'zh'
                assign project_time = project_time | replace: '時間', '小时'
                case forloop.index
                  when 1
                    assign project_title = '淡彩抽绳包'
                  when 2
                    assign project_title = '蕾丝手编团扇'
                  when 3
                    assign project_title = '花火镂空披肩'
                  when 4
                    assign project_title = '渐变波纹毯'
                  when 5
                    assign project_title = '荷叶边肩背包'
                endcase
              when 'en'
                assign project_time = project_time | replace: '時間', ' hr'
                case forloop.index
                  when 1
                    assign project_title = 'Pastel drawstring bag'
                  when 2
                    assign project_title = 'Lace crochet fan'
                  when 3
                    assign project_title = 'Hanabi openwork shawl'
                  when 4
                    assign project_title = 'Gradient wave blanket'
                  when 5
                    assign project_title = 'Ruffled shoulder bag'
                endcase
            endcase

            assign purpose_product = all_products[purpose_handle]
            assign purpose_link = purpose_product.url | default: block.settings.link | default: routes.all_products_collection_url
          %}
          <a
            class="yarn-purpose__card yarn-purpose__card--{{ forloop.index }}"
            href="{{ purpose_link }}"
            {{ block.shopify_attributes }}
          >
            <span class="yarn-purpose__media">
              {%- if purpose_product.featured_image != blank -%}
                {{
                  purpose_product.featured_image
                  | image_url: width: 840
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 720, 840',
                    sizes: '(min-width: 990px) 18vw, (min-width: 750px) 31vw, 72vw',
                    alt: project_title
                }}
              {%- endif -%}
            </span>
            <span class="yarn-purpose__card-copy">
              <strong>{{ project_title | escape }}</strong>
              <span class="yarn-purpose__meta">
                <small>
                  <span class="svg-wrapper" aria-hidden="true">{{- 'icon-plant.svg' | inline_asset_content -}}</span>
                  {{ card_level | escape }}
                </small>
                <small>
                  <span class="svg-wrapper" aria-hidden="true">{{- 'icon-stopwatch.svg' | inline_asset_content -}}</span>
                  {{ project_time | escape }}
                </small>
              </span>
              <small class="yarn-purpose__kit">
                <span class="svg-wrapper" aria-hidden="true">{{- 'icon-box.svg' | inline_asset_content -}}</span>
                {{ kit_label | escape }}
              </small>
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-purpose {
    overflow: hidden;
    padding: clamp(34px, 4.5vw, 62px) 0 clamp(46px, 5vw, 72px);
    background: #fffdf9;
    color: #493d31;
  }

  .yarn-purpose__head {
    display: flex;
    gap: 28px;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
  }

  .yarn-purpose__eyebrow {
    display: none;
  }

  .yarn-purpose__title {
    margin: 0;
    color: #493d31;
    font-family: 'Songti SC', 'Hiragino Mincho ProN', 'Yu Mincho', 'Noto Serif CJK SC', Georgia, serif;
    font-size: clamp(2.4rem, 2.4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .yarn-purpose__intro {
    max-width: 48rem;
    margin-top: 7px;
    color: rgba(73, 61, 49, 0.68);
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .yarn-purpose__intro p {
    margin: 0;
  }

  .yarn-purpose__view-all {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 8px 0;
    color: #596f3f;
    font-size: 1.3rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .yarn-purpose__view-all .svg-wrapper {
    width: 16px;
    height: 16px;
  }

  .yarn-purpose__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .yarn-purpose__card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(73, 61, 49, 0.14);
    border-radius: 13px;
    background: #ffffff;
    color: #493d31;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .yarn-purpose__card:nth-child(n + 5) {
    display: none;
  }

  .yarn-purpose__card:hover,
  .yarn-purpose__card:focus-visible {
    border-color: rgba(125, 144, 100, 0.72);
    box-shadow: 0 12px 28px rgba(73, 61, 49, 0.08);
    transform: translateY(-3px);
  }

  .yarn-purpose__media {
    display: block;
    aspect-ratio: 1.42;
    overflow: hidden;
    background: #f6f1e8;
  }

  .yarn-purpose__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .yarn-purpose__card:hover .yarn-purpose__media img,
  .yarn-purpose__card:focus-visible .yarn-purpose__media img {
    transform: scale(1.025);
  }

  .yarn-purpose__card-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 13px 14px 14px;
  }

  .yarn-purpose__card-copy > strong {
    overflow: hidden;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .yarn-purpose__meta {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 7px;
    color: rgba(73, 61, 49, 0.66);
  }

  .yarn-purpose__meta small,
  .yarn-purpose__kit {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    font-size: 1.05rem;
  }

  .yarn-purpose__meta small + small {
    padding-left: 8px;
    border-left: 1px solid rgba(73, 61, 49, 0.16);
  }

  .yarn-purpose__meta .svg-wrapper,
  .yarn-purpose__kit .svg-wrapper {
    width: 13px;
    height: 13px;
  }

  .yarn-purpose__meta .svg-wrapper {
    color: #718653;
  }

  .yarn-purpose__kit {
    margin-top: 9px;
    color: rgba(73, 61, 49, 0.74);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .yarn-purpose__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .yarn-purpose__card:nth-child(4) {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .yarn-purpose {
      padding-top: 20px;
      padding-bottom: 28px;
    }

    .yarn-purpose__card {
      height: 160px;
      grid-template-columns: minmax(0, 1.55fr) minmax(108px, 1fr);
    }

    .yarn-purpose__media {
      min-height: 0;
      aspect-ratio: auto;
    }

    .yarn-purpose__card-copy {
      justify-content: center;
      padding: 12px;
    }

    .yarn-purpose__meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .yarn-purpose__meta small + small {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .yarn-purpose {
      padding: 28px 0 38px;
    }

    .yarn-purpose .page-width {
      padding-right: 0;
      padding-left: 20px;
    }

    .yarn-purpose__head {
      padding-right: 20px;
      margin-bottom: 15px;
    }

    .yarn-purpose__title {
      font-size: 2rem;
    }

    .yarn-purpose__intro {
      display: none;
    }

    .yarn-purpose__view-all {
      font-size: 1.15rem;
    }

    .yarn-purpose__scroller {
      overflow-x: auto;
      padding: 0 20px 8px 0;
      scrollbar-width: none;
      scroll-padding-left: 20px;
      scroll-snap-type: x proximity;
    }

    .yarn-purpose__scroller::-webkit-scrollbar {
      display: none;
    }

    .yarn-purpose__grid {
      display: grid;
      width: max-content;
      grid-auto-columns: minmax(228px, 72vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      gap: 12px;
    }

    .yarn-purpose__card,
    .yarn-purpose__card:nth-child(n + 5) {
      display: grid;
      width: min(72vw, 270px);
      scroll-snap-align: start;
    }

    .yarn-purpose__media {
      aspect-ratio: 1.48;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "入门作品推荐",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "FIRST PROJECTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "はじめてにおすすめの作品"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "说明",
      "default": "<p>小さな作品から一度完成させて、自分のペースで手づくりを好きになっていきましょう。</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "purpose",
      "name": "作品卡片",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "备用链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "入门作品推荐",
      "blocks": [
        { "type": "purpose" },
        { "type": "purpose" },
        { "type": "purpose" },
        { "type": "purpose" },
        { "type": "purpose" }
      ]
    }
  ]
}
{% endschema %}
