{% comment %}
  Section-local translations use Shopify's documented sections.<file> prefix.
  Theme Check currently tests that full prefix against the unprefixed schema.
  The exact keys and all three locales are validated by the discovery contract test.
{% endcomment %}
{% # theme-check-disable TranslationKeyExists %}
{{ 'yarn-project-discovery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-project-discovery.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  case request.locale.iso_code
    when 'zh', 'zh-CN'
      assign heading = section.settings.heading_zh
      assign intro = section.settings.intro_zh
    when 'en'
      assign heading = section.settings.heading_en
      assign intro = section.settings.intro_en
  endcase
  assign catalogue = section.settings.collection
  assign featured_products = section.settings.featured_products
  assign featured_handles = featured_products | map: 'handle'
%}
<section id="shop-by-project" class="yarn-project-discovery" aria-labelledby="DiscoveryHeading-{{ section.id }}">
  <yarn-project-discovery id="discover-products" class="yarn-project-discovery__inner" data-initial-limit="4" data-default-type="kit">
    <header class="yarn-project-discovery__heading">
      <img src="{{ 'impeccable-category-heading-flourish.png' | asset_url }}" alt="" width="1706" height="368" loading="lazy">
      <h2 id="DiscoveryHeading-{{ section.id }}">{{ heading | escape }}</h2>
      {% if intro != blank %}<p>{{ intro | escape }}</p>{% endif %}
    </header>
    <form class="yarn-project-discovery__form" data-yarn-form action="{{ routes.search_url }}" role="search">
      <div class="yarn-project-discovery__search">
        <label class="visually-hidden" for="DiscoveryQuery-{{ section.id }}">{{ 'sections.yarn-project-discovery.search' | t }}</label>
        <input id="DiscoveryQuery-{{ section.id }}" data-yarn-query type="search" name="q" placeholder="{{ 'sections.yarn-project-discovery.search' | t }}" autocomplete="off">
        <button type="submit" aria-label="{{ 'sections.yarn-project-discovery.submit' | t }}">{{ 'icon-search.svg' | inline_asset_content }}</button>
      </div>
      <nav class="yarn-project-discovery__categories" aria-label="{{ 'sections.yarn-project-discovery.categories' | t }}">
        {% assign category_keys = 'bag,shawl,blanket,toy' | split: ',' %}
        {% for key in category_keys %}
          {% liquid
            assign asset_name = 'impeccable-category-bag-plate.png'
            case key
              when 'shawl'
                assign asset_name = 'impeccable-category-scarf-plate.png'
              when 'blanket'
                assign asset_name = 'impeccable-b-category-blanket-plate.png'
              when 'toy'
                assign asset_name = 'impeccable-category-doll-plate.png'
            endcase
            assign label_key = 'sections.yarn-project-discovery.' | append: key
          %}
          <a class="yarn-project-discovery__category" href="?discover_type=kit&amp;discover_project={{ key }}#discover-products" data-yarn-pick="project" data-value="{{ key }}" aria-controls="DiscoveryResults-{{ section.id }}">
            <span class="yarn-project-discovery__category-art yarn-project-discovery__category-art--{{ key }}"><img src="{{ asset_name | asset_url }}" alt="" width="1479" height="1064" loading="lazy"></span>
            <span>{{ label_key | t }}</span>
          </a>
        {% endfor %}
      </nav>
      <div class="yarn-project-discovery__types" role="group" aria-label="{{ 'sections.yarn-project-discovery.types' | t }}">
        {% assign type_keys = 'kit,yarn,tool' | split: ',' %}
        {% for key in type_keys %}
          {% assign label_key = 'sections.yarn-project-discovery.' | append: key %}
          <button type="button" data-yarn-pick="type" data-value="{{ key }}" aria-controls="DiscoveryResults-{{ section.id }}" aria-pressed="{% if key == 'kit' %}true{% else %}false{% endif %}">{{ label_key | t }}</button>
        {% endfor %}
      </div>
      <div class="yarn-project-discovery__fallback-filters">
        <label>{{ 'sections.yarn-project-discovery.types' | t }}
          <select data-yarn-filter="type" name="discover_type">
            <option value="">{{ 'sections.yarn-project-discovery.all' | t }}</option>
            {% assign type_keys = 'kit,yarn,tool,finished,bundle' | split: ',' %}
            {% for key in type_keys %}{% assign label_key = 'sections.yarn-project-discovery.' | append: key %}<option value="{{ key }}" {% if key == 'kit' %}selected{% endif %}>{{ label_key | t }}</option>{% endfor %}
          </select>
        </label>
        <label>{{ 'sections.yarn-project-discovery.project' | t }}
          <select data-yarn-filter="project" name="discover_project">
            <option value="">{{ 'sections.yarn-project-discovery.all' | t }}</option>
            {% assign project_keys = 'bag,shawl,blanket,toy,fan,gift' | split: ',' %}
            {% for key in project_keys %}{% assign label_key = 'sections.yarn-project-discovery.' | append: key %}<option value="{{ key }}">{{ label_key | t }}</option>{% endfor %}
          </select>
        </label>
      </div>
      <div class="yarn-project-discovery__filters">
        {% assign filter_keys = 'quantity,season,style' | split: ',' %}
        {% for key in filter_keys %}
          {% liquid
            assign label_key = 'sections.yarn-project-discovery.' | append: key
            case key
              when 'quantity'
                assign default_key = 'sections.yarn-project-discovery.all_quantity'
                assign values = 'one-ball,large-ball' | split: ','
                assign labels = 'one_ball,large_ball' | split: ','
              when 'season'
                assign default_key = 'sections.yarn-project-discovery.all_seasons'
                assign values = 'spring,summer,cold' | split: ','
                assign labels = values
              when 'style'
                assign default_key = 'sections.yarn-project-discovery.all_styles'
                assign values = 'gradient,flower,lace,sparkle' | split: ','
                assign labels = values
            endcase
          %}
          <div class="yarn-project-discovery__filter" data-yarn-dropdown>
            <label class="visually-hidden" for="DiscoveryFilter-{{ key }}-{{ section.id }}">{{ label_key | t }}</label>
            <select id="DiscoveryFilter-{{ key }}-{{ section.id }}" data-yarn-filter="{{ key }}" name="discover_{{ key }}">
              <option value="">{{ default_key | t }}</option>
              {% for value in values %}{% assign option_key = 'sections.yarn-project-discovery.' | append: labels[forloop.index0] %}<option value="{{ value }}">{{ option_key | t }}</option>{% endfor %}
            </select>
            <button class="yarn-project-discovery__filter-trigger" type="button" data-yarn-trigger aria-expanded="false" aria-controls="DiscoveryOptions-{{ key }}-{{ section.id }}" hidden><span data-yarn-filter-label>{{ default_key | t }}</span>{{ 'icon-caret.svg' | inline_asset_content }}</button>
            <div class="yarn-project-discovery__options" id="DiscoveryOptions-{{ key }}-{{ section.id }}" data-yarn-options role="group" aria-label="{{ label_key | t }}" hidden></div>
          </div>
        {% endfor %}
      </div>
    </form>
    <div class="yarn-project-discovery__status">
      <p role="status" aria-live="polite" data-yarn-result-count data-template="{{ 'sections.yarn-project-discovery.count' | t }}"></p>
      <button type="button" data-yarn-clear hidden>{{ 'sections.yarn-project-discovery.clear' | t }}</button>
    </div>
    <div id="DiscoveryResults-{{ section.id }}" data-yarn-results>
      <ul class="yarn-project-discovery__grid" role="list">
        {% for product in featured_products %}{% render 'yarn-work-card', product: product %}{% endfor %}
        {% paginate catalogue.products by 50 %}
          {% for product in catalogue.products %}
            {% unless featured_handles contains product.handle %}{% render 'yarn-work-card', product: product %}{% endunless %}
          {% endfor %}
        {% endpaginate %}
      </ul>
      <div class="yarn-project-discovery__empty" data-yarn-empty hidden>
        <h3>{{ 'sections.yarn-project-discovery.empty' | t }}</h3>
        <p>{{ 'sections.yarn-project-discovery.empty_help' | t }}</p>
        <button type="button" data-yarn-related hidden>{{ 'sections.yarn-project-discovery.related_yarn' | t }}</button>
        <button type="button" data-yarn-clear>{{ 'sections.yarn-project-discovery.clear' | t }}</button>
      </div>
    </div>
    <div class="yarn-project-discovery__end">
      <button type="button" data-yarn-more hidden>{{ 'sections.yarn-project-discovery.more' | t }} {{ 'icon-caret.svg' | inline_asset_content }}</button>
      <a href="{{ catalogue.url | default: routes.all_products_collection_url }}">{{ 'sections.yarn-project-discovery.catalogue' | t }} {{ 'icon-arrow.svg' | inline_asset_content }}</a>
    </div>
    <noscript><p>{{ 'sections.yarn-project-discovery.noscript' | t }}</p></noscript>
  </yarn-project-discovery>
</section>

