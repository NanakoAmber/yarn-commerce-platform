{{ 'yarn-cards.css' | asset_url | stylesheet_tag }}
{% comment %}
  首页精选区块(卡片家族):标题 + 查看全部 + 可选出口卡钩子 + 商品卡网格。
  文案设置以店主语言(中文)填写,日英走主题内容翻译层。
{% endcomment %}
{%- liquid
  assign picks_collection = collections[section.settings.collection]
  assign picks_limit = section.settings.products_to_show
-%}
<section class="yx-picks yarn-shell-block color-{{ section.settings.color_scheme }}" style="--yx-cols: {{ section.settings.columns_desktop }};" aria-labelledby="Picks-{{ section.id }}">
  <div class="yx-picks__inner page-width">
    <div class="yx-picks__head">
      <h2 id="Picks-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if picks_collection != blank -%}<a class="yx-picks__all" href="{{ picks_collection.url }}">{{ 'yarn_project.card_view_all' | t }} →</a>{%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="yx-picks__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    {%- if section.settings.exit_enabled -%}
      <aside class="yx-exit yx-picks__exit">
        <div>
          <h3 class="yx-exit__title">{{ section.settings.exit_title | escape }}</h3>
          {%- if section.settings.exit_text != blank -%}<p class="yx-exit__text">{{ section.settings.exit_text | escape }}</p>{%- endif -%}
          <a class="yx-exit__cta" href="{{ section.settings.exit_link | default: picks_collection.url }}">{{ section.settings.exit_cta | escape }} <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
        </div>
        {%- if section.settings.exit_image != blank -%}<div class="yx-exit__media">{{ section.settings.exit_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 750px) 420px, 45vw', loading: 'lazy', alt: '' }}</div>{%- endif -%}
        {%- if section.settings.exit_note != blank -%}<p class="yx-exit__note">{{ section.settings.exit_note | escape }}</p>{%- endif -%}
      </aside>
    {%- endif -%}
    {%- if picks_collection != blank and picks_collection.products_count > 0 -%}
      <div class="yx-picks__grid">
        {%- for pick_product in picks_collection.products limit: picks_limit -%}
          {%- render 'yarn-pick-card', card_product: pick_product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% style %}
  .yx-picks { padding: var(--yarn-space-6, 32px) 0; }
  .yx-picks__note { margin: -6px 0 12px; font-size: 1.3rem; color: var(--yarn-muted); }
{% endstyle %}
{% schema %}
{
  "name": "精选区块(卡片家族)",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "毛线精选" },
    { "type": "text", "id": "note", "label": "辅助说明(可空)" },
    { "type": "collection", "id": "collection", "label": "集合" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "商品数" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "default": 4, "label": "桌面列数" },
    { "type": "header", "content": "出口卡钩子(可选)" },
    { "type": "checkbox", "id": "exit_enabled", "label": "显示出口卡", "default": false },
    { "type": "text", "id": "exit_title", "label": "出口卡标题" },
    { "type": "text", "id": "exit_text", "label": "出口卡说明" },
    { "type": "text", "id": "exit_cta", "label": "出口卡按钮文字" },
    { "type": "url", "id": "exit_link", "label": "出口卡链接(空则用集合)" },
    { "type": "image_picker", "id": "exit_image", "label": "出口卡图片" },
    { "type": "text", "id": "exit_note", "label": "出口卡脚注(如配对示意说明)" },
    { "type": "select", "id": "color_scheme", "label": "配色", "options": [ { "value": "scheme-1", "label": "默认" } ], "default": "scheme-1" }
  ],
  "presets": [ { "name": "精选区块(卡片家族)" } ]
}
{% endschema %}
