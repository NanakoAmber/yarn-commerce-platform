{% unless template.name == 'index' %}{{ 'hitoami-home.css' | asset_url | stylesheet_tag }}{% endunless %}
<script src="{{ 'hitoami-home.js' | asset_url }}" defer="defer"></script>

<hitoami-home class="hitoami-home" data-motion="{{ section.settings.enable_cat }}">
  {% if section.blocks.size > 0 %}
    <section class="hitoami-hero" aria-label="{{ 'hitoami_home.featured' | t }}" aria-roledescription="{{ 'hitoami_home.carousel' | t }}">
      <div class="hitoami-slides">
        {% for block in section.blocks %}
          {% liquid
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image | default: desktop_image
            assign desktop_image = desktop_image | default: mobile_image
            assign desktop_asset = 'hitoami-room-wide.webp'
            assign mobile_asset = 'hitoami-room-mobile.webp'
            if block.settings.scene == 'yarn'
              assign desktop_asset = 'hitoami-yarn-mobile.webp'
              assign mobile_asset = 'hitoami-yarn-mobile.webp'
            endif
            capture heading
              render 'yarn-setting-text', settings: block.settings, key: 'heading'
            endcapture
            capture text
              render 'yarn-setting-text', settings: block.settings, key: 'text'
            endcapture
            capture cta
              render 'yarn-setting-text', settings: block.settings, key: 'cta'
            endcapture
            assign target = block.settings.link
            if target == blank
              assign target = collections['knit-kits'].url | default: routes.all_products_collection_url
              if block.settings.scene == 'yarn'
                assign target = collections['yarn'].url | default: routes.all_products_collection_url
              endif
            endif
          %}
          <article id="HitoamiSlide-{{ block.id }}" class="hitoami-slide hitoami-slide--{{ block.settings.tone }}" data-slide data-block-id="{{ block.id }}" aria-roledescription="{{ 'hitoami_home.slide' | t }}" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" {% unless forloop.first %}hidden inert{% endunless %} {{ block.shopify_attributes }}>
            <picture class="hitoami-scene" style="--scene-focus: {{ block.settings.focus }}%;">
              {% if mobile_image != blank %}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w" sizes="100vw">
              {% else %}
                <source media="(max-width: 749px)" srcset="{{ mobile_asset | asset_url }}">
              {% endif %}
              {% if desktop_image != blank %}
                <img src="{{ desktop_image | image_url: width: 1600 }}" srcset="{{ desktop_image | image_url: width: 900 }} 900w, {{ desktop_image | image_url: width: 1600 }} 1600w, {{ desktop_image | image_url: width: 2200 }} 2200w" sizes="100vw" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}" alt="" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {% else %}
                <img src="{{ desktop_asset | asset_url }}" width="1600" height="1000" alt="" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {% endif %}
            </picture>
            <div class="hitoami-copy">
              {% if forloop.first %}<h1 class="hitoami-heading">{{ heading | escape | newline_to_br }}</h1>{% else %}<h2 class="hitoami-heading">{{ heading | escape | newline_to_br }}</h2>{% endif %}
              {% if text != blank %}<p class="hitoami-subtitle">{{ text | escape }}</p>{% endif %}
              {% if cta != blank %}<a class="hitoami-cta" href="{{ target }}">{{ cta | escape }}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="hitoami-controls" hidden>
          <button class="hitoami-arrow hitoami-arrow--previous" type="button" data-previous aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"><span aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></button>
          <button class="hitoami-arrow hitoami-arrow--next" type="button" data-next aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"><span aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></button>
          <div class="hitoami-pagination">
            <span class="hitoami-count" aria-hidden="true"><span data-current>01</span> / {{ section.blocks.size | prepend: '00' | slice: -2, 2 }}</span>
            <div class="hitoami-dots">
              {% for block in section.blocks %}<button type="button" data-page="{{ forloop.index0 }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}" aria-controls="HitoamiSlide-{{ block.id }}" {% if forloop.first %}aria-current="true"{% endif %}><span></span></button>{% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
      <span class="visually-hidden" data-slide-status aria-live="polite" aria-atomic="true"></span>
    </section>
  {% endif %}

  <nav class="hitoami-guide" aria-label="{{ 'hitoami_home.categories' | t }}">
    <svg class="hitoami-wave" viewBox="0 0 1440 52" preserveAspectRatio="none" aria-hidden="true"><path d="M0 25 C180 -10 340 52 560 28 S850 0 1020 25 S1260 45 1440 14 V52 H0Z"/></svg>
    <div class="hitoami-guide-inner">
      <div class="hitoami-cat-lane" aria-hidden="true">
        <svg class="hitoami-thread"><path data-thread d="M8 60 Q22 65 80 60"/></svg>
        <span class="hitoami-cat" data-cat></span>
        <img class="hitoami-ball" data-ball src="{{ 'hitoami-yarn-ball.svg' | asset_url }}" width="22" height="22" alt="">
      </div>
      <ul class="hitoami-categories" role="list">
        {% assign category_keys = 'yarn,kit,finished' | split: ',' %}
        {% for key in category_keys %}
          {% liquid
            assign setting_key = key | append: '_collection'
            assign destination = section.settings[setting_key].url
            if destination == blank
              case key
                when 'yarn'
                  assign destination = collections['yarn'].url
                when 'kit'
                  assign destination = collections['knit-kits'].url
                when 'finished'
                  assign destination = collections['finished-goods'].url
              endcase
            endif
            assign destination = destination | default: routes.all_products_collection_url
            case key
              when 'yarn'
                assign icon = 'hitoami-nav-yarn.webp'
              when 'kit'
                assign icon = 'hitoami-nav-kit.webp'
              when 'finished'
                assign icon = 'hitoami-nav-finished.webp'
            endcase
            assign label = 'hitoami_home.' | append: key
          %}
          <li><a class="hitoami-category hitoami-category--{{ key }}" href="{{ destination }}" data-category="{{ forloop.index0 }}"><span class="hitoami-category-art"><img src="{{ icon | asset_url }}" width="360" height="360" alt="" loading="eager"></span><span>{{ label | t }}</span></a></li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</hitoami-home>

{% if section.settings.show_story %}
  {% capture story_heading %}{% render 'yarn-setting-text', settings: section.settings, key: 'story_heading' %}{% endcapture %}
  {% capture story_text %}{% render 'yarn-setting-text', settings: section.settings, key: 'story_text' %}{% endcapture %}
  <section class="hitoami-story" aria-labelledby="HitoamiStory-{{ section.id }}">
    <h2 id="HitoamiStory-{{ section.id }}">{{ story_heading | escape | newline_to_br }}</h2>
    <div class="rte">{{ story_text }}</div>
  </section>
{% endif %}

{% schema %}
{
  "name": "hitoami · 手作小屋",
  "tag": "section",
  "class": "section hitoami-home-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cat",
      "label": "启用小猫动画",
      "default": true
    },
    {
      "type": "collection",
      "id": "yarn_collection",
      "label": "毛线入口"
    },
    {
      "type": "collection",
      "id": "kit_collection",
      "label": "编织材料包入口"
    },
    {
      "type": "collection",
      "id": "finished_collection",
      "label": "成品入口"
    },
    {
      "type": "checkbox",
      "id": "show_story",
      "label": "显示品牌介绍",
      "default": true
    },
    {
      "type": "textarea",
      "id": "story_heading",
      "label": "日文 · 品牌标语",
      "default": "最初のひと目から、\n編みもので、人と暮らしをやさしくつなぐ。"
    },
    {
      "type": "textarea",
      "id": "story_heading_zh",
      "label": "中文 · 品牌标语",
      "default": "从第一针开始，\n用编织，温柔连接人与生活。"
    },
    {
      "type": "textarea",
      "id": "story_heading_en",
      "label": "英文 · 品牌标语",
      "default": "From the first stitch,\nweaving warmth into everyday connections."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "日文 · 品牌故事",
      "default": "<p>hitoami は、「一」と「編む」という想いから生まれました。</p><p>最初のひと目から、糸と色、ひらめきを少しずつ暮らしの中へ。初めて毛糸に触れる人も、手づくりが好きな人も。ひと目ひと目に自分のペースを見つけ、編みものを愛する誰かと出会える場所でありたいと願っています。</p>"
    },
    {
      "type": "richtext",
      "id": "story_text_zh",
      "label": "中文 · 品牌故事",
      "default": "<p>hitoami，取意于「一」与「编织」。</p><p>从第一针开始，把线、色彩与灵感慢慢编进日常。无论初次拿起毛线，还是早已钟情手作，都能在一针一线之间找到自己的节奏，也与同样热爱编织的人相遇。</p>"
    },
    {
      "type": "richtext",
      "id": "story_text_en",
      "label": "英文 · 品牌故事",
      "default": "<p>hitoami brings together the ideas of “one” and “knitting”.</p><p>From the first stitch, bring yarn, colour and imagination into everyday life. Whether you are picking up yarn for the first time or have always loved making, find your own rhythm, one stitch at a time—and connect with others who share that love.</p>"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "活动幻灯片",
      "settings": [
        {
          "type": "select",
          "id": "scene",
          "label": "未上传时使用的氛围图",
          "default": "kit",
          "options": [
            {
              "value": "kit",
              "label": "手作桌"
            },
            {
              "value": "yarn",
              "label": "毛线柜"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "桌面背景图"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "手机背景图",
          "info": "不填则使用桌面图；建议竖图，上部留白供标题显示。"
        },
        {
          "type": "range",
          "id": "focus",
          "label": "图片水平焦点",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "select",
          "id": "tone",
          "label": "文字颜色",
          "default": "dark",
          "options": [
            {
              "value": "dark",
              "label": "深色文字（浅图）"
            },
            {
              "value": "light",
              "label": "浅色文字（深图）"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "日文 · 标题",
          "default": "ここで、\n毎日を少しゆっくりと。"
        },
        {
          "type": "textarea",
          "id": "heading_zh",
          "label": "中文 · 标题",
          "default": "来这里，\n把日子过慢一点。"
        },
        {
          "type": "textarea",
          "id": "heading_en",
          "label": "英文 · 标题",
          "default": "Come in.\nTake life a stitch slower."
        },
        {
          "type": "text",
          "id": "text",
          "label": "日文 · 说明",
          "default": "材料と編み図を、ゆっくり選ぼう。"
        },
        {
          "type": "text",
          "id": "text_zh",
          "label": "中文 · 说明",
          "default": "材料与图解，一起慢慢挑。"
        },
        {
          "type": "text",
          "id": "text_en",
          "label": "英文 · 说明",
          "default": "Find your yarn, your pattern, your pace."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "日文 · 按钮",
          "default": "編みキットを見る"
        },
        {
          "type": "text",
          "id": "cta_zh",
          "label": "中文 · 按钮",
          "default": "看看编织包"
        },
        {
          "type": "text",
          "id": "cta_en",
          "label": "英文 · 按钮",
          "default": "Explore the kits"
        },
        {
          "type": "url",
          "id": "link",
          "label": "按钮链接",
          "info": "留空时按氛围图进入材料包或毛线集合；可链接任意活动、商品或内容页。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "hitoami · 手作小屋",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
