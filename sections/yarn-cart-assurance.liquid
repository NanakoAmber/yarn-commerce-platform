{%- liquid
  assign title_1 = '日本全国へ配送'
  assign text_1 = '税込9,900円以上で送料無料'
  assign title_2 = '糸選びをサポート'
  assign text_2 = '色合わせや必要量を相談できます'
  assign title_3 = '安心してお買いもの'
  assign text_3 = 'ご注文内容は決済前に確認できます'
  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign title_1 = '日本全国配送'
      assign text_1 = '订单含税满9,900日元免运费'
      assign title_2 = '选线支持'
      assign text_2 = '可咨询配色与作品所需用量'
      assign title_3 = '放心购物'
      assign text_3 = '付款前可以再次确认订单内容'
    when 'en'
      assign title_1 = 'Delivery across Japan'
      assign text_1 = 'Free shipping on orders over ¥9,900'
      assign title_2 = 'Yarn guidance'
      assign text_2 = 'Ask about colour matching and quantity'
      assign title_3 = 'Shop with confidence'
      assign text_3 = 'Review your order before payment'
  endcase
-%}

<section class="yarn-cart-assurance color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width yarn-cart-assurance__grid">
    <div><span aria-hidden="true">01</span><strong>{{ title_1 }}</strong><p>{{ text_1 }}</p></div>
    <div><span aria-hidden="true">02</span><strong>{{ title_2 }}</strong><p>{{ text_2 }}</p></div>
    <div><span aria-hidden="true">03</span><strong>{{ title_3 }}</strong><p>{{ text_3 }}</p></div>
  </div>
</section>

{% stylesheet %}
  .yarn-cart-assurance { padding: 0 0 3rem; }
  .yarn-cart-assurance__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; }
  .yarn-cart-assurance__grid > div { min-height: 12rem; padding: 2.2rem; border: 1px solid rgba(120, 185, 216, 0.18); border-radius: 14px; background: #f1f9fd; }
  .yarn-cart-assurance__grid > div:nth-child(2) { background: #fff2f5; }
  .yarn-cart-assurance__grid > div:nth-child(3) { background: #eef8f3; }
  .yarn-cart-assurance span { color: #4b89ab; font-size: 1.1rem; letter-spacing: 0.1em; }
  .yarn-cart-assurance strong { display: block; margin-top: 1.4rem; font-size: 1.5rem; font-weight: 600; }
  .yarn-cart-assurance p { margin: 0.6rem 0 0; font-size: 1.3rem; line-height: 1.6; opacity: 0.72; }
  @media screen and (max-width: 749px) {
    .yarn-cart-assurance__grid { grid-template-columns: 1fr; gap: 0.8rem; }
    .yarn-cart-assurance__grid > div { min-height: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "购物车安心说明",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1" }
  ],
  "presets": [{ "name": "购物车安心说明" }]
}
{% endschema %}
