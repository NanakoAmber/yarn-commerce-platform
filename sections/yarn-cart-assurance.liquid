<section class="yarn-cart-assurance color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width yarn-cart-assurance__grid">
    <div><span aria-hidden="true">01</span><strong>{{ 'yarn_cart_assurance.title_1' | t }}</strong><p>{{ 'yarn_cart_assurance.text_1' | t }}</p></div>
    <div><span aria-hidden="true">02</span><strong>{{ 'yarn_cart_assurance.title_2' | t }}</strong><p>{{ 'yarn_cart_assurance.text_2' | t }}</p></div>
    <div><span aria-hidden="true">03</span><strong>{{ 'yarn_cart_assurance.title_3' | t }}</strong><p>{{ 'yarn_cart_assurance.text_3' | t }}</p></div>
  </div>
</section>

{% stylesheet %}
  .yarn-cart-assurance { padding: 0 0 3rem; }
  .yarn-cart-assurance__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; }
  .yarn-cart-assurance__grid > div { min-height: 12rem; padding: 2.2rem; border: 1px solid var(--yarn-border-card); border-radius: var(--yarn-card-radius); background: var(--yarn-action-subtle-bg); }
  .yarn-cart-assurance__grid > div:nth-child(2) { background: var(--yarn-tint-blush); }
  .yarn-cart-assurance__grid > div:nth-child(3) { background: var(--yarn-tint-sage); }
  .yarn-cart-assurance span { color: var(--yarn-accent); font-size: 1.1rem; letter-spacing: 0.1em; }
  .yarn-cart-assurance strong { display: block; margin-top: 1.4rem; font-size: 1.5rem; font-weight: 600; }
  .yarn-cart-assurance p { margin: 0.6rem 0 0; font-size: 1.3rem; line-height: 1.6; opacity: 0.72; }
  @media screen and (max-width: 749px) {
    .yarn-cart-assurance__grid { grid-template-columns: 1fr; gap: 0.8rem; }
    .yarn-cart-assurance__grid > div { min-height: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "购物车安心说明",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1" }
  ],
  "presets": [{ "name": "购物车安心说明" }]
}
{% endschema %}
