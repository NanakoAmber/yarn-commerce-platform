{% comment %}
  首屏露边轮播 + 品牌介绍(方案 E-c ②,2026-09-24 用户选定)。
  每个 slide block:图片(未上传时用 fallback_asset 主题素材)、链接、三语名称(读屏与分页用)。
  介绍区文案按 yarn-hero 的三联模式:纯键名为日文默认,_zh/_en 为中英覆盖。图片上不压文字。
{% endcomment %}
{{ 'yarn-hero-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-hero-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign intro_eyebrow = section.settings.eyebrow
  assign intro_heading = section.settings.heading
  assign intro_text = section.settings.text
  assign intro_button = section.settings.button_label
  case request.locale.iso_code
    when 'zh-CN', 'zh'
      assign intro_eyebrow = section.settings.eyebrow_zh
      assign intro_heading = section.settings.heading_zh
      assign intro_text = section.settings.text_zh
      assign intro_button = section.settings.button_label_zh
    when 'en'
      assign intro_eyebrow = section.settings.eyebrow_en
      assign intro_heading = section.settings.heading_en
      assign intro_text = section.settings.text_en
      assign intro_button = section.settings.button_label_en
  endcase

  assign slide_count = section.blocks.size
  assign half = slide_count | divided_by: 2
-%}

<section
  class="yarn-carousel"
  data-yarn-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ intro_heading | escape }}"
>
  {%- if slide_count > 0 -%}
    <div class="yarn-carousel__viewport">
      <ul class="yarn-carousel__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign slide_title = block.settings.title
            case request.locale.iso_code
              when 'zh-CN', 'zh'
                assign slide_title = block.settings.title_zh
              when 'en'
                assign slide_title = block.settings.title_en
            endcase
            assign img_loading = 'lazy'
            if forloop.first
              assign img_loading = 'eager'
            endif
            assign offset = forloop.index0
            if offset > half
              assign offset = offset | minus: slide_count
            endif
          -%}
          <li
            class="yarn-carousel__slide{% if forloop.first %} is-current{% endif %}"
            style="--offset: {{ offset }};"
            data-index="{{ forloop.index0 }}"
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
            aria-label="{{ forloop.index }} / {{ slide_count }}{% if slide_title != blank %} · {{ slide_title | escape }}{% endif %}"
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            <a
              class="yarn-carousel__link"
              href="{{ block.settings.link | default: routes.collections_url }}"
              {% unless forloop.first %}tabindex="-1"{% endunless %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 750px) 760px, 86vw',
                    loading: img_loading,
                    alt: block.settings.image.alt | default: slide_title
                }}
              {%- elsif block.settings.fallback_asset != blank -%}
                <img
                  src="{{ block.settings.fallback_asset | asset_url }}"
                  alt="{{ slide_title | escape }}"
                  width="1536"
                  height="1024"
                  {% unless forloop.first %}loading="lazy"{% endunless %}
                >
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if slide_count > 1 -%}
        <button type="button" class="yarn-carousel__arrow yarn-carousel__arrow--prev" data-carousel-prev aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" class="yarn-carousel__arrow yarn-carousel__arrow--next" data-carousel-next aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
          <span aria-hidden="true">→</span>
        </button>
      {%- endif -%}
    </div>

    {%- if slide_count > 1 -%}
      <div class="yarn-carousel__pager">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="yarn-carousel__dot"
            data-carousel-go="{{ forloop.index0 }}"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} / {{ slide_count }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if intro_heading != blank or intro_text != blank -%}
    <div class="yarn-carousel__intro">
      {%- if intro_eyebrow != blank -%}<p class="yarn-carousel__eyebrow">{{ intro_eyebrow | escape }}</p>{%- endif -%}
      {%- if intro_heading != blank -%}<h2 class="yarn-carousel__heading">{{ intro_heading | escape }}</h2>{%- endif -%}
      {%- if intro_text != blank -%}<div class="yarn-carousel__text">{{ intro_text }}</div>{%- endif -%}
      {%- if intro_button != blank and section.settings.button_link != blank -%}
        <a class="yarn-carousel__button" href="{{ section.settings.button_link }}">{{ intro_button | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "首屏轮播",
  "tag": "div",
  "class": "section-yarn-hero-carousel",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "自动轮播(每 6 秒;悬停、聚焦或系统减少动态时暂停)", "default": false },
    { "type": "header", "content": "品牌介绍 · 日文(默认)" },
    { "type": "text", "id": "eyebrow", "label": "小标题", "default": "ABOUT BRAND" },
    { "type": "text", "id": "heading", "label": "标题", "default": "BRAND へようこそ" },
    { "type": "richtext", "id": "text", "label": "介绍", "default": "<p>ひと玉の良い糸が、ひとつの作品のはじまりだと考えています。<br>厳選した毛糸、編みものキット、完成品とともに、ゆっくり作品づくりを楽しんでください。</p>" },
    { "type": "text", "id": "button_label", "label": "按钮文字", "default": "BRAND について" },
    { "type": "header", "content": "品牌介绍 · 中文" },
    { "type": "text", "id": "eyebrow_zh", "label": "小标题", "default": "ABOUT BRAND" },
    { "type": "text", "id": "heading_zh", "label": "标题", "default": "欢迎来到 BRAND" },
    { "type": "richtext", "id": "text_zh", "label": "介绍", "default": "<p>我们相信，一团好线就是一件作品的开始。<br>这里有精选毛线、编织包与手作成品，陪你慢慢完成一件作品。</p>" },
    { "type": "text", "id": "button_label_zh", "label": "按钮文字", "default": "关于 BRAND" },
    { "type": "header", "content": "品牌介绍 · 英文" },
    { "type": "text", "id": "eyebrow_en", "label": "小标题", "default": "ABOUT BRAND" },
    { "type": "text", "id": "heading_en", "label": "标题", "default": "Welcome to BRAND" },
    { "type": "richtext", "id": "text_en", "label": "介绍", "default": "<p>We believe a good ball of yarn is where every piece begins.<br>Find curated yarn, knit kits and finished pieces, and take your time making something of your own.</p>" },
    { "type": "text", "id": "button_label_en", "label": "按钮文字", "default": "About BRAND" },
    { "type": "url", "id": "button_link", "label": "按钮链接" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "横幅",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片(建议 16:10,宽 1600px 以上)" },
        { "type": "text", "id": "fallback_asset", "label": "未上传图片时使用的主题素材文件名", "info": "内部预览用,例如 yarn-hero-worktable-v2.png" },
        { "type": "url", "id": "link", "label": "链接" },
        { "type": "text", "id": "title", "label": "名称 · 日文(读屏与分页)" },
        { "type": "text", "id": "title_zh", "label": "名称 · 中文" },
        { "type": "text", "id": "title_en", "label": "名称 · 英文" }
      ]
    }
  ],
  "presets": [{ "name": "首屏轮播" }]
}
{% endschema %}
